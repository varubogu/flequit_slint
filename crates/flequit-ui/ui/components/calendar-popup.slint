import { LineEdit, SpinBox } from "std-widgets.slint";
import { Theme } from "../globals/theme.slint";
import { Layout } from "../globals/layout.slint";
import { Actions } from "../globals/actions.slint";
import { SettingsState } from "../globals/settings.slint";
import { I18n } from "../globals/i18n.slint";
import { ParsedDateTime } from "../globals/types.slint";
import { DialogButton } from "dialog-button.slint";
import { IconButton } from "icon-button.slint";
import { IconName } from "icon.slint";

// Picks a date, and optionally a time, either by typing or from a month grid.
//
// Replaces `std-widgets`' `DatePickerPopup`, which cannot be restyled from the
// outside (its month arrows are an internal icon button with a 48px minimum
// around a 12px glyph, so they stretch to the height of their row) and which
// had to be chained into a second popup for the time of day.
//
// The caller sets `year` … `minute`, bumps `open-token` and calls `show()`.
// A popup can only be driven from the enclosing component through `show()` and
// `close()`, so the token is how the editor is rewound to the stored value on
// every open. Nothing leaves the popup until `accepted` fires.
export component CalendarPopup inherits PopupWindow {
    in property <string> title;
    in property <int> year: 2026;
    in property <int> month: 1;
    in property <int> day: 1;
    in property <int> hour: 0;
    in property <int> minute: 0;
    // False where only a date is meaningful, such as the last date of a repeat
    // rule.
    in property <bool> with-time: true;
    in property <int> open-token;

    callback accepted(int /* year */, int /* month */, int /* day */,
                      int /* hour */, int /* minute */);

    // The value being edited. Kept apart from the `in` properties so paging the
    // calendar or typing never writes back until the user confirms.
    private property <int> edit-year: 2026;
    private property <int> edit-month: 1;
    private property <int> edit-day: 1;
    private property <int> edit-hour: 0;
    private property <int> edit-minute: 0;
    // Months paged away from the one being edited.
    private property <int> month-offset: 0;

    private property <bool> monday-first: SettingsState.week-start == "monday";
    private property <length> cell-size: Layout.touch-target;
    private property <length> title-height: Theme.font-size-base + 8px;
    private property <length> weekday-height: Theme.font-size-sm + 8px;

    width: Math.max(7 * root.cell-size, 260px) + 2 * Theme.space-sm;
    // Seven stacked rows — title, text field, month header, weekday header,
    // grid, footer — plus the optional time row.
    height: 2 * Theme.space-sm + 5 * Theme.space-xs
        + root.title-height + 3 * Layout.touch-target + root.weekday-height
        + 6 * root.cell-size
        + (root.with-time ? Layout.touch-target + Theme.space-xs : 0px);
    close-policy: PopupClosePolicy.close-on-click-outside;

    changed open-token => {
        root.edit-year = root.year;
        root.edit-month = root.month;
        root.edit-day = root.day;
        root.edit-hour = root.hour;
        root.edit-minute = root.minute;
        root.month-offset = 0;
        typed.text = "";
    }

    pure function leap-year(y: int) -> bool {
        return Math.mod(y, 4) == 0 && (Math.mod(y, 100) != 0 || Math.mod(y, 400) == 0);
    }

    pure function days-in-month(y: int, m: int) -> int {
        return m == 2 ? (root.leap-year(y) ? 29 : 28)
            : (m == 4 || m == 6 || m == 9 || m == 11) ? 30
            : 31;
    }

    // Sakamoto's shift table, indexed by month.
    pure function month-shift(m: int) -> int {
        return m == 1 ? 0 : m == 2 ? 3 : m == 3 ? 2 : m == 4 ? 5
            : m == 5 ? 0 : m == 6 ? 3 : m == 7 ? 5 : m == 8 ? 1
            : m == 9 ? 4 : m == 10 ? 6 : m == 11 ? 2 : 4;
    }

    // Weekday of the first of the month, 0 = Sunday.
    pure function first-weekday(y: int, m: int) -> int {
        return Math.mod(
            (m < 3 ? y - 1 : y)
                + Math.floor((m < 3 ? y - 1 : y) / 4)
                - Math.floor((m < 3 ? y - 1 : y) / 100)
                + Math.floor((m < 3 ? y - 1 : y) / 400)
                + root.month-shift(m) + 1,
            7);
    }

    private property <int> display-index:
        root.edit-year * 12 + root.edit-month - 1 + root.month-offset;
    private property <int> display-year: Math.floor(root.display-index / 12);
    private property <int> display-month: Math.mod(root.display-index, 12) + 1;
    // Empty cells before the first of the month.
    private property <int> lead-offset:
        Math.mod(root.first-weekday(root.display-year, root.display-month)
            + (root.monday-first ? 6 : 0), 7);
    private property <int> display-length:
        root.days-in-month(root.display-year, root.display-month);
    private property <string> month-label:
        I18n.calendar-month-label(root.display-year, root.display-month);

    // Applies what the user typed. Text that is not a date leaves the editor
    // alone, which is the normal state halfway through typing one.
    function apply(text: string) -> bool {
        let parsed: ParsedDateTime = Actions.parse-datetime(text, root.edit-year, root.edit-month,
                                                            root.edit-day, root.edit-hour,
                                                            root.edit-minute);
        if (!parsed.valid) {
            return false;
        }
        root.edit-year = parsed.year;
        root.edit-month = parsed.month;
        root.edit-day = parsed.day;
        if (parsed.has-time && root.with-time) {
            root.edit-hour = parsed.hour;
            root.edit-minute = parsed.minute;
        }
        root.month-offset = 0;
        return true;
    }

    function commit() {
        root.close();
        root.accepted(root.edit-year, root.edit-month, root.edit-day,
                      root.edit-hour, root.edit-minute);
    }

    Rectangle {
        width: 100%;
        height: 100%;
        background: Theme.surface-raised;
        border-radius: Theme.radius-md;
        border-width: 1px;
        border-color: Theme.border;
    }

    VerticalLayout {
        width: 100%;
        height: 100%;
        padding: Theme.space-sm;
        spacing: Theme.space-xs;

        Text {
            height: root.title-height;
            text: root.title;
            color: Theme.text-muted;
            font-size: Theme.font-size-sm;
            vertical-alignment: center;
            overflow: elide;
        }

        typed := LineEdit {
            height: Layout.touch-target;
            placeholder-text: root.with-time
                ? @tr("Calendar" => "2026/9/15 13:30")
                : @tr("Calendar" => "2026/9/15");
            accessible-label: root.with-time
                ? @tr("Calendar" => "Type a date and time")
                : @tr("Calendar" => "Type a date");
            edited(text) => { root.apply(text); }
            accepted(text) => {
                if (root.apply(text)) {
                    root.commit();
                }
            }
        }

        HorizontalLayout {
            height: Layout.touch-target;
            spacing: Theme.space-xs;

            IconButton {
                icon: IconName.chevron-left;
                tooltip: @tr("Calendar" => "Previous month");
                clicked => { root.month-offset -= 1; }
            }

            Text {
                text: root.month-label;
                color: Theme.text;
                font-size: Theme.font-size-base;
                horizontal-alignment: center;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }

            IconButton {
                icon: IconName.chevron-right;
                tooltip: @tr("Calendar" => "Next month");
                clicked => { root.month-offset += 1; }
            }
        }

        HorizontalLayout {
            height: root.weekday-height;

            for column in 7: Text {
                private property <int> weekday: Math.mod(column + (root.monday-first ? 1 : 0), 7);
                text: I18n.weekday-abbreviation(self.weekday);
                color: Theme.text-muted;
                font-size: Theme.font-size-sm;
                horizontal-alignment: center;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
        }

        // One layout around the weeks, so the rows sit flush against each
        // other and the popup's height only has to count this as a single row.
        VerticalLayout {
            height: 6 * root.cell-size;

            for week in 6: HorizontalLayout {
                height: root.cell-size;

                for column in 7: Rectangle {
                    private property <int> day-number: week * 7 + column - root.lead-offset + 1;
                    private property <bool> in-month:
                        self.day-number >= 1 && self.day-number <= root.display-length;
                    private property <bool> is-selected: self.in-month
                        && self.day-number == root.edit-day
                        && root.display-month == root.edit-month
                        && root.display-year == root.edit-year;

                    horizontal-stretch: 1;
                    border-radius: Theme.radius-sm;
                    background: self.is-selected ? Theme.surface-selected
                        : (self.in-month && day-touch.has-hover) ? Theme.surface-hover
                        : transparent;

                    Text {
                        text: parent.in-month ? "\{parent.day-number}" : "";
                        color: Theme.text;
                        font-size: Theme.font-size-base;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }

                    day-touch := TouchArea {
                        clicked => {
                            if (parent.in-month) {
                                root.edit-year = root.display-year;
                                root.edit-month = root.display-month;
                                root.edit-day = parent.day-number;
                                root.month-offset = 0;
                            }
                        }
                    }
                    accessible-role: button;
                    accessible-label: self.in-month
                        ? @tr("Calendar" => "Day {0} of {1}", self.day-number, root.month-label)
                        : "";
                    accessible-action-default => { day-touch.clicked(); }
                }
            }
        }

        if root.with-time: HorizontalLayout {
            height: Layout.touch-target;
            spacing: Theme.space-xs;

            Text {
                text: @tr("Calendar" => "Time");
                color: Theme.text-muted;
                font-size: Theme.font-size-sm;
                vertical-alignment: center;
            }

            SpinBox {
                horizontal-stretch: 1;
                value: root.edit-hour;
                minimum: 0;
                maximum: 23;
                accessible-label: @tr("Calendar" => "Hour");
                edited(value) => { root.edit-hour = value; }
            }

            Text {
                text: ":";
                color: Theme.text;
                font-size: Theme.font-size-base;
                vertical-alignment: center;
            }

            SpinBox {
                horizontal-stretch: 1;
                value: root.edit-minute;
                minimum: 0;
                maximum: 59;
                accessible-label: @tr("Calendar" => "Minute");
                edited(value) => { root.edit-minute = value; }
            }
        }

        HorizontalLayout {
            height: Layout.touch-target;
            spacing: Theme.space-sm;
            alignment: end;

            DialogButton {
                label: @tr("Calendar" => "Cancel");
                clicked => { root.close(); }
            }

            DialogButton {
                label: @tr("Calendar" => "OK");
                primary: true;
                clicked => { root.commit(); }
            }
        }
    }
}
