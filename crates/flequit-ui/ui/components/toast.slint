import { Theme } from "../globals/theme.slint";
import { Layout } from "../globals/layout.slint";
import { Icon, IconName } from "icon.slint";

// Short-lived notice floating above the content, with an optional action.
//
// Deliberately knows nothing about why it is shown or for how long: the owner
// decides both, so one component serves every transient message.
export component Toast inherits Rectangle {
    in property <string> message;
    // Empty hides the action.
    in property <string> action-label;
    callback action-clicked();
    callback dismissed();

    height: content.preferred-height;
    background: Theme.surface-raised;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: Theme.border;
    drop-shadow-blur: 12px;
    drop-shadow-offset-y: 2px;
    drop-shadow-color: #00000040;
    accessible-role: text;
    accessible-label: root.message;

    // Clicks on the toast must not reach the content underneath.
    TouchArea { }

    content := HorizontalLayout {
        padding: Theme.space-sm;
        padding-left: Theme.space-lg;
        spacing: Theme.space-sm;

        Text {
            text: root.message;
            color: Theme.text;
            font-size: Theme.font-size-base;
            overflow: elide;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }

        if root.action-label != "": Rectangle {
            min-width: action-text.preferred-width + 2 * Theme.space-md;
            height: Layout.touch-target;
            border-radius: Theme.radius-sm;
            background: action-touch.has-hover ? Theme.surface-hover : transparent;
            accessible-role: button;
            accessible-label: root.action-label;
            accessible-action-default => { root.action-clicked(); }

            action-text := Text {
                text: root.action-label;
                color: Theme.accent;
                font-size: Theme.font-size-base;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%;
                height: 100%;
            }
            action-touch := TouchArea { clicked => { root.action-clicked(); } }
        }

        Rectangle {
            width: Layout.touch-target;
            height: Layout.touch-target;
            border-radius: Theme.radius-sm;
            background: close-touch.has-hover ? Theme.surface-hover : transparent;
            accessible-role: button;
            accessible-label: @tr("Toast" => "Dismiss");
            accessible-action-default => { root.dismissed(); }

            Icon {
                name: IconName.close;
                tint: Theme.text-muted;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
            close-touch := TouchArea { clicked => { root.dismissed(); } }
        }
    }
}
