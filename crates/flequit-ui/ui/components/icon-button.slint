import { Theme } from "../globals/theme.slint";
import { Layout } from "../globals/layout.slint";
import { Icon, IconName } from "icon.slint";
import { FocusRing } from "focus-ring.slint";

// Square, icon-only button sized to the current breakpoint's hit area.
//
// `icon` is the normal case; `label` remains for the few glyphs that have no
// drawn counterpart and for callers that want a character badge.
export component IconButton inherits Rectangle {
    in property <IconName> icon: IconName.none;
    in property <string> label;
    in property <string> tooltip;
    in property <bool> active: false;
    callback clicked();

    width: Layout.touch-target;
    height: Layout.touch-target;
    border-radius: Theme.radius-sm;
    background: root.active ? Theme.surface-selected
        : touch.has-hover ? Theme.surface-hover
        : transparent;
    accessible-role: button;
    accessible-label: root.tooltip != "" ? root.tooltip : root.label;
    accessible-action-default => { root.clicked(); }
    forward-focus: key-focus;

    if root.icon != IconName.none: Icon {
        name: root.icon;
        tint: Theme.text;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }

    if root.icon == IconName.none: Text {
        text: root.label;
        color: Theme.text;
        font-size: Theme.font-size-lg;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: 100%;
        height: 100%;
    }

    key-focus := FocusScope {
        key-pressed(event) => {
            if (event.text == " " || event.text == "\n") {
                root.clicked();
                return accept;
            }
            reject
        }
    }

    if key-focus.has-focus: FocusRing {
        radius: root.border-radius;
    }

    touch := TouchArea {
        // Clicking a control moves keyboard focus onto it, so the next Tab
        // continues from where the pointer left off.
        clicked => {
            key-focus.focus();
            root.clicked();
        }
    }
}
