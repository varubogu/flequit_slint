import { Theme } from "../globals/theme.slint";
import { Layout } from "../globals/layout.slint";
import { Icon, IconName } from "icon.slint";
import { FocusRing } from "focus-ring.slint";

// Narrow button for the controls that sit at the end of a list row.
//
// Sized to a glyph rather than to the touch target's width, so several fit
// beside a name without pushing it out of view.
export component RowButton inherits Rectangle {
    in property <IconName> icon: IconName.none;
    in property <string> label;
    in property <string> action-label;
    callback clicked();

    width: Layout.is-compact ? Layout.touch-target : Theme.space-lg;
    height: Layout.touch-target;
    border-radius: Theme.radius-sm;
    background: touch.has-hover ? Theme.surface-hover : transparent;

    if root.icon != IconName.none: Icon {
        name: root.icon;
        size: Theme.font-size-sm + 4px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }

    if root.icon == IconName.none: Text {
        text: root.label;
        color: Theme.text-muted;
        font-size: Theme.font-size-sm;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: 100%;
        height: 100%;
    }

    key-focus := FocusScope {
        key-pressed(event) => {
            if (event.text == " " || event.text == "\n") {
                root.clicked();
                return accept;
            }
            reject
        }
    }

    if key-focus.has-focus: FocusRing {
        radius: root.border-radius;
    }

    touch := TouchArea {
        clicked => {
            key-focus.focus();
            root.clicked();
        }
    }
    forward-focus: key-focus;
    accessible-role: button;
    accessible-label: root.action-label;
    accessible-action-default => { root.clicked(); }
}
