import { Theme } from "../globals/theme.slint";
import { Layout } from "../globals/layout.slint";
import { FocusRing } from "focus-ring.slint";
import { Icon, IconName } from "icon.slint";

// One entry of a `SelectField` list.
//
// `value` is an opaque tag the caller chose; the field never interprets it, so
// an enum-backed caller maps it back on the way out.
export struct SelectOption {
    value: int,
    label: string,
    // What assistive technology reads, e.g. "Set status to Waiting": the label
    // alone does not say what picking it does.
    action-label: string,
    indicator-color: brush,
}

// A single-choice field that opens its options in front of the form.
//
// Used where a row of buttons would eat a whole line of the form for a value
// the user rarely changes. The list is a `PopupWindow` so it floats above the
// surrounding fields instead of pushing them down.
//
// The caller resolves the current option itself (`value-label` / `value-color`),
// because .slint cannot look a model entry up by key.
export component SelectField inherits Rectangle {
    in property <[SelectOption]> options;
    // The currently selected `SelectOption.value`.
    in property <int> value;
    in property <string> value-label;
    in property <brush> value-color: transparent;
    // Names the field itself for assistive technology, e.g. "Change status".
    in property <string> label;

    callback selected(int /* value */);

    height: Layout.touch-target;
    background: field-touch.has-hover ? Theme.surface-hover : Theme.surface;
    border-radius: Theme.radius-sm;
    border-width: 1px;
    border-color: Theme.border;
    forward-focus: key-focus;
    accessible-role: combobox;
    accessible-label: root.label;
    accessible-value: root.value-label;
    accessible-expandable: true;
    accessible-action-default => { list-popup.show(); }
    accessible-action-expand => { list-popup.show(); }

    HorizontalLayout {
        padding-left: Theme.space-sm;
        padding-right: Theme.space-sm;
        spacing: Theme.space-sm;

        Rectangle {
            width: 4px;
            height: 16px;
            y: (parent.height - self.height) / 2;
            border-radius: 2px;
            background: root.value-color;
        }

        Text {
            text: root.value-label;
            color: Theme.text;
            font-size: Theme.font-size-base;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }

        Icon {
            name: IconName.chevron-down;
            tint: Theme.text-muted;
            y: (parent.height - self.height) / 2;
        }
    }

    key-focus := FocusScope {
        key-pressed(event) => {
            if (event.text == " " || event.text == "\n") {
                list-popup.show();
                return accept;
            }
            reject
        }
    }

    if key-focus.has-focus: FocusRing {
        radius: root.border-radius;
    }

    field-touch := TouchArea {
        clicked => {
            key-focus.focus();
            list-popup.show();
        }
    }

    list-popup := PopupWindow {
        x: 0;
        y: root.height + Theme.space-xs;
        width: root.width;
        height: root.options.length * Layout.touch-target + 2 * Theme.space-xs;
        close-policy: PopupClosePolicy.close-on-click-outside;

        Rectangle {
            width: 100%;
            height: 100%;
            background: Theme.surface-raised;
            border-radius: Theme.radius-sm;
            border-width: 1px;
            border-color: Theme.border;
        }

        VerticalLayout {
            width: 100%;
            height: 100%;
            padding: Theme.space-xs;

            for option in root.options: Rectangle {
                height: Layout.touch-target;
                border-radius: Theme.radius-sm;
                background: option.value == root.value ? Theme.surface-selected
                    : option-touch.has-hover ? Theme.surface-hover
                    : transparent;

                HorizontalLayout {
                    padding-left: Theme.space-sm;
                    padding-right: Theme.space-sm;
                    spacing: Theme.space-sm;

                    Rectangle {
                        width: 4px;
                        height: 16px;
                        y: (parent.height - self.height) / 2;
                        border-radius: 2px;
                        background: option.indicator-color;
                    }

                    Text {
                        text: option.label;
                        color: Theme.text;
                        font-size: Theme.font-size-base;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                }

                option-touch := TouchArea {
                    clicked => {
                        list-popup.close();
                        root.selected(option.value);
                    }
                }
                accessible-role: button;
                accessible-label: option.action-label;
                accessible-action-default => { option-touch.clicked(); }
            }
        }
    }
}
