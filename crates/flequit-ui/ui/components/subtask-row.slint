import { Theme } from "../globals/theme.slint";
import { Layout } from "../globals/layout.slint";
import { SubTaskItem } from "../globals/types.slint";
import { IconButton } from "icon-button.slint";
import { IconName } from "icon.slint";

// One subtask beneath an expanded task row.
//
// Smaller than a task row and without its own metadata: a subtask is a step of
// its parent, not a task in its own right.
export component SubTaskRow inherits Rectangle {
    in property <SubTaskItem> subtask;

    callback clicked();
    callback toggled();

    height: Layout.touch-target;
    border-radius: Theme.radius-sm;
    // A subtask the search found while its parent task did not match is
    // marked, since it is the reason the parent row is listed.
    background: row-touch.has-hover ? Theme.surface-hover
        : root.subtask.search-match ? Theme.surface-selected
        : transparent;

    row-touch := TouchArea {
        // Keep the row target behind the checkbox and edit button so each
        // pointer action reaches the control the user chose.
        z: -1;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: Theme.space-sm;
        spacing: Theme.space-sm;
        alignment: stretch;

        Rectangle {
            width: Layout.touch-target;

            Rectangle {
                width: 14px;
                height: 14px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                border-radius: Theme.radius-sm;
                border-width: 1px;
                border-color: root.subtask.completed ? Theme.accent : Theme.border;
                background: root.subtask.completed ? Theme.accent : transparent;
            }

            TouchArea {
                clicked => { root.toggled(); }
            }

            accessible-role: checkbox;
            accessible-checkable: true;
            accessible-checked: root.subtask.completed;
            accessible-label: @tr("TaskList" => "Complete {0}", root.subtask.title);
            accessible-action-default => { root.toggled(); }
        }

        Text {
            text: root.subtask.title;
            color: root.subtask.completed ? Theme.text-muted : Theme.text;
            font-size: Theme.font-size-sm;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }

        IconButton {
            icon: IconName.edit;
            tooltip: @tr("TaskList" => "Edit subtask {0}", root.subtask.title);
            clicked => { root.clicked(); }
        }
    }

    accessible-role: button;
    accessible-label: root.subtask.search-match
        ? @tr("TaskList" => "Open subtask {0}, matches the search", root.subtask.title)
        : @tr("TaskList" => "Open subtask {0}", root.subtask.title);
    accessible-action-default => { root.clicked(); }
}
