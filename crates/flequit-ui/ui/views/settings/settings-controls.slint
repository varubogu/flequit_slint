import { LineEdit } from "std-widgets.slint";
import { Theme } from "../../globals/theme.slint";
import { Layout } from "../../globals/layout.slint";

// Edits what the user calls a filter or preset, e.g. "今期" for this quarter.
//
// The translated default label is the placeholder, so clearing the field goes
// back to it. Commits on Enter or when focus leaves rather than on every
// keystroke, so a half-typed name is not saved.
export component NameField inherits LineEdit {
    in property <string> name;
    in property <string> default-label;
    callback committed(string /* name */);

    text: root.name;
    placeholder-text: root.default-label;
    accessible-label: @tr("Settings" => "Name for {0}", root.default-label);
    accepted(value) => {
        if (value != root.name) {
            root.committed(value);
        }
    }
    changed has-focus => {
        if (!self.has-focus && self.text != root.name) {
            root.committed(self.text);
        }
    }
}

export component SectionTitle inherits Text {
    color: Theme.text;
    font-size: Theme.font-size-title;
    font-weight: 600;
    vertical-alignment: center;
}

export component FieldLabel inherits Text {
    color: Theme.text-muted;
    font-size: Theme.font-size-sm;
    vertical-alignment: center;
}

export component ChoiceButton inherits Rectangle {
    in property <string> label;
    in property <bool> selected: false;
    callback clicked();

    height: Layout.touch-target;
    min-width: 4 * Theme.space-xl;
    border-radius: Theme.radius-sm;
    border-width: 1px;
    border-color: root.selected ? Theme.accent : Theme.border;
    background: root.selected ? Theme.surface-selected
        : touch.has-hover ? Theme.surface-hover : Theme.surface;

    Text {
        text: root.label;
        color: Theme.text;
        font-size: Theme.font-size-base;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea { clicked => { root.clicked(); } }
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
}

export component CapabilityRow inherits Rectangle {
    in property <string> title;
    in property <string> description;

    height: Layout.touch-target + 2 * Theme.space-md;
    border-radius: Theme.radius-sm;
    background: Theme.surface;
    HorizontalLayout {
        padding: Theme.space-md;
        spacing: Theme.space-md;
        VerticalLayout {
            spacing: Theme.space-xs;
            horizontal-stretch: 1;
            Text { text: root.title; color: Theme.text; font-size: Theme.font-size-base; }
            Text { text: root.description; color: Theme.text-muted; font-size: Theme.font-size-sm; }
        }
        Text {
            text: @tr("Settings" => "Available");
            color: Theme.success;
            font-size: Theme.font-size-sm;
            vertical-alignment: center;
        }
    }
}
