import { Theme } from "../../globals/theme.slint";
import { Layout } from "../../globals/layout.slint";

export component SectionTitle inherits Text {
    color: Theme.text;
    font-size: Theme.font-size-title;
    font-weight: 600;
    vertical-alignment: center;
}

export component FieldLabel inherits Text {
    color: Theme.text-muted;
    font-size: Theme.font-size-sm;
    vertical-alignment: center;
}

export component ChoiceButton inherits Rectangle {
    in property <string> label;
    in property <bool> selected: false;
    callback clicked();

    height: Layout.touch-target;
    min-width: 4 * Theme.space-xl;
    border-radius: Theme.radius-sm;
    border-width: 1px;
    border-color: root.selected ? Theme.accent : Theme.border;
    background: root.selected ? Theme.surface-selected
        : touch.has-hover ? Theme.surface-hover : Theme.surface;

    Text {
        text: root.label;
        color: Theme.text;
        font-size: Theme.font-size-base;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea { clicked => { root.clicked(); } }
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
}

export component CapabilityRow inherits Rectangle {
    in property <string> title;
    in property <string> description;

    height: Layout.touch-target + 2 * Theme.space-md;
    border-radius: Theme.radius-sm;
    background: Theme.surface;
    HorizontalLayout {
        padding: Theme.space-md;
        spacing: Theme.space-md;
        VerticalLayout {
            spacing: Theme.space-xs;
            horizontal-stretch: 1;
            Text { text: root.title; color: Theme.text; font-size: Theme.font-size-base; }
            Text { text: root.description; color: Theme.text-muted; font-size: Theme.font-size-sm; }
        }
        Text {
            text: @tr("Settings" => "Available");
            color: Theme.success;
            font-size: Theme.font-size-sm;
            vertical-alignment: center;
        }
    }
}
