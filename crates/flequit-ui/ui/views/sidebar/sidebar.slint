import { ScrollView } from "std-widgets.slint";
import { Theme } from "../../globals/theme.slint";
import { Layout } from "../../globals/layout.slint";
import { AppState } from "../../globals/app-state.slint";
import { Actions } from "../../globals/actions.slint";
import { EditorKind } from "../../globals/types.slint";
import { IconButton } from "../../components/icon-button.slint";
import { IconName } from "../../components/icon.slint";
import { DueFilterList } from "due-filter-list.slint";
import { StatusFilterList } from "status-filter-list.slint";
import { ProjectTree } from "project-tree.slint";
import { TagBookmarkList } from "tag-bookmark-list.slint";
import { SearchBox } from "search-box.slint";
import { AccountMenu } from "account-menu.slint";

// Left navigation: search, due-date filters and the project tree.
//
// The caller decides both presentation and whether the collapse control is
// available, so this component works in inline and overlay contexts.
export component Sidebar inherits Rectangle {
    in property <bool> collapsed: false;
    in property <bool> collapse-enabled: true;
    callback collapse-toggled();

    background: Theme.surface;

    function add-project() {
        AppState.editor = {
            kind: EditorKind.project,
            target-id: "",
            project-id: "",
            name: "",
            color: "",
            archived: false,
        };
        AppState.editor-open = true;
    }

    VerticalLayout {
        padding-top: Layout.safe-area-top;
        padding-left: Layout.safe-area-left;
        spacing: 0px;

        // --- Header ---
        HorizontalLayout {
            padding: Theme.space-sm;
            spacing: Theme.space-sm;

            if root.collapse-enabled: IconButton {
                icon: root.collapsed ? IconName.chevron-right : IconName.chevron-left;
                tooltip: @tr("Sidebar" => "Toggle sidebar");
                clicked => { root.collapse-toggled(); }
            }

            if !root.collapsed: SearchBox {
                horizontal-stretch: 1;
                text <=> AppState.search-query;
                suggestions: AppState.search-suggestions;
                candidates: AppState.search-candidates;
            }
        }

        // --- Content ---
        ScrollView {
            vertical-stretch: 1;

            VerticalLayout {
                padding: Theme.space-sm;
                spacing: Theme.space-lg;
                alignment: start;

                VerticalLayout {
                    spacing: 2px;

                    DueFilterList {
                        collapsed: root.collapsed;
                    }

                    StatusFilterList {
                        collapsed: root.collapsed;
                    }
                }

                TagBookmarkList {
                    collapsed: root.collapsed;
                }

                VerticalLayout {
                    spacing: 2px;

                    if !root.collapsed: HorizontalLayout {
                        spacing: Theme.space-sm;

                        Text {
                            text: @tr("Sidebar" => "Projects");
                            color: Theme.text-muted;
                            font-size: Theme.font-size-sm;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }

                        IconButton {
                            icon: IconName.plus;
                            tooltip: @tr("Sidebar" => "New project");
                            clicked => { root.add-project(); }
                        }
                    }

                    ProjectTree {
                        collapsed: root.collapsed;
                    }
                }
            }
        }

        // --- Footer ---
        HorizontalLayout {
            padding: Theme.space-sm;
            padding-bottom: Theme.space-sm + Layout.safe-area-bottom;
            spacing: Theme.space-sm;
            alignment: start;

            AccountMenu {
                collapsed: root.collapsed;
                horizontal-stretch: 1;
            }

            if !root.collapsed: IconButton {
                icon: IconName.archive;
                tooltip: AppState.show-archived-projects
                    ? @tr("Sidebar" => "Hide archived projects")
                    : @tr("Sidebar" => "Show archived projects");
                active: AppState.show-archived-projects;
                clicked => { Actions.toggle-archived-projects(); }
            }
        }
    }
}
