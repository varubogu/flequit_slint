import { Theme } from "../../globals/theme.slint";
import { Layout } from "../../globals/layout.slint";
import { Actions } from "../../globals/actions.slint";
import { SettingsState } from "../../globals/settings.slint";
import { SettingsCategory } from "../../globals/types.slint";
import { Icon, IconName } from "../../components/icon.slint";

component AccountMenuItem inherits Rectangle {
    in property <IconName> icon;
    in property <string> label;
    callback clicked();

    height: Layout.touch-target;
    border-radius: Theme.radius-sm;
    background: touch.has-hover ? Theme.surface-hover : transparent;

    HorizontalLayout {
        padding-left: Theme.space-sm;
        padding-right: Theme.space-sm;
        spacing: Theme.space-sm;

        Icon {
            name: root.icon;
            tint: Theme.text;
            y: (parent.height - self.height) / 2;
        }

        Text {
            text: root.label;
            color: Theme.text;
            font-size: Theme.font-size-base;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
    }

    touch := TouchArea { clicked => { root.clicked(); } }
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
}

// Current-account summary and its application-level destinations.
export component AccountMenu inherits Rectangle {
    in property <bool> collapsed: false;

    height: Layout.touch-target;
    min-width: Layout.touch-target;
    border-radius: Theme.radius-sm;
    background: account-touch.has-hover ? Theme.surface-hover : transparent;

    private property <string> account-label: SettingsState.account-name == ""
        ? @tr("AccountMenu" => "Local account")
        : SettingsState.account-name;

    HorizontalLayout {
        padding-left: Theme.space-sm;
        padding-right: Theme.space-sm;
        spacing: Theme.space-sm;

        Icon {
            name: IconName.account;
            tint: Theme.text;
            y: (parent.height - self.height) / 2;
        }

        if !root.collapsed: Text {
            text: root.account-label;
            color: Theme.text;
            font-size: Theme.font-size-base;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }

        if !root.collapsed: Icon {
            name: IconName.chevron-up;
            size: Theme.font-size-sm + 4px;
            y: (parent.height - self.height) / 2;
        }
    }

    account-touch := TouchArea {
        clicked => {
            if account-popup.is-open { account-popup.close(); }
            else { account-popup.show(); }
        }
    }
    accessible-role: button;
    accessible-label: @tr("AccountMenu" => "Open account menu");
    accessible-action-default => {
        if account-popup.is-open { account-popup.close(); }
        else { account-popup.show(); }
    }

    account-popup := PopupWindow {
        x: 0px;
        y: 0px - self.height;
        width: root.collapsed ? Layout.sidebar-overlay-width - 2 * Theme.space-sm : root.width;
        height: 4 * Layout.touch-target + 2 * Theme.space-xs;
        close-policy: close-on-click-outside;

        Rectangle {
            border-radius: Theme.radius-md;
            border-width: 1px;
            border-color: Theme.border;
            background: Theme.surface-raised;
            clip: true;

            VerticalLayout {
                padding: Theme.space-xs;
                spacing: 0px;

                Rectangle {
                    height: Layout.touch-target;
                    HorizontalLayout {
                        padding-left: Theme.space-sm;
                        padding-right: Theme.space-sm;
                        spacing: Theme.space-sm;

                        Icon {
                            name: IconName.account;
                            tint: Theme.text;
                            size: Theme.font-size-lg + 4px;
                            y: (parent.height - self.height) / 2;
                        }

                        VerticalLayout {
                            alignment: center;
                            spacing: 0px;
                            Text {
                                text: root.account-label;
                                color: Theme.text;
                                font-size: Theme.font-size-base;
                                overflow: elide;
                            }
                            Text {
                                text: SettingsState.account-email;
                                color: Theme.text-muted;
                                font-size: Theme.font-size-sm;
                                overflow: elide;
                            }
                        }
                    }
                }

                AccountMenuItem {
                    icon: IconName.settings;
                    label: @tr("AccountMenu" => "Settings");
                    clicked => {
                        account-popup.close();
                        Actions.open-settings();
                    }
                }

                AccountMenuItem {
                    icon: IconName.account;
                    label: @tr("AccountMenu" => "Account settings");
                    clicked => {
                        account-popup.close();
                        Actions.open-settings();
                        Actions.select-settings-category(SettingsCategory.account);
                    }
                }

                AccountMenuItem {
                    icon: IconName.help;
                    label: @tr("AccountMenu" => "Help");
                    clicked => {
                        account-popup.close();
                        Actions.open-help();
                    }
                }
            }
        }
    }
}
