import { Theme } from "../../globals/theme.slint";
import { Layout } from "../../globals/layout.slint";
import { AppState } from "../../globals/app-state.slint";
import { TaskListItem } from "../../globals/types.slint";
import { RowButton } from "../../components/row-button.slint";
import { IconName } from "../../components/icon.slint";

// One task list under a project, and a drop target for a dragged task.
export component TaskListRow inherits Rectangle {
    in property <TaskListItem> list;
    in property <bool> selected: false;

    callback chosen();
    callback edit();

    // A dragged task can only be dropped on a list in its own project; moving
    // across projects is a different operation.
    property <bool> drop-target:
        AppState.is-dragging
        && AppState.dragging-project-id == root.list.project-id
        && AppState.drag-x >= self.absolute-position.x
        && AppState.drag-x < self.absolute-position.x + self.width
        && AppState.drag-y >= self.absolute-position.y
        && AppState.drag-y < self.absolute-position.y + self.height;

    // The dragged row keeps the pointer grab, so the target it is over has to
    // publish itself rather than wait for a drop event of its own.
    changed drop-target => {
        if (self.drop-target) {
            AppState.drop-list-id = root.list.id;
        } else if (AppState.drop-list-id == root.list.id) {
            AppState.drop-list-id = "";
        }
    }

    height: Layout.touch-target;
    border-radius: Theme.radius-sm;
    border-width: self.drop-target ? 1px : 0px;
    border-color: Theme.accent;
    background: self.drop-target ? Theme.surface-hover
        : root.selected ? Theme.surface-selected
        : row-touch.has-hover ? Theme.surface-hover
        : transparent;

    HorizontalLayout {
        padding-left: Theme.space-sm;
        padding-right: Theme.space-sm;
        spacing: Theme.space-sm;

        Text {
            text: root.list.name;
            color: Theme.text;
            font-size: Theme.font-size-base;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }

        if root.list.task-count > 0: Text {
            text: root.list.task-count;
            color: Theme.text-muted;
            font-size: Theme.font-size-sm;
            vertical-alignment: center;
        }

        RowButton {
            icon: IconName.edit;
            action-label: @tr("Sidebar" => "Edit {0}", root.list.name);
            clicked => { root.edit(); }
        }
    }

    row-touch := TouchArea {
        // Behind the edit button so that it wins the click.
        z: -1;
        clicked => { root.chosen(); }
    }
    accessible-role: button;
    accessible-label: root.list.name;
    accessible-action-default => { root.chosen(); }
}
