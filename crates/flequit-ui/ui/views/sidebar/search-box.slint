import { LineEdit, ListView } from "std-widgets.slint";
import { Theme } from "../../globals/theme.slint";
import { Layout } from "../../globals/layout.slint";
import { AppState } from "../../globals/app-state.slint";
import { SearchSuggestion, SearchSuggestionKind } from "../../globals/types.slint";
import { Icon, IconName } from "../../components/icon.slint";

// Search input with candidates supplied by the ViewModel.
//
// The view owns only presentation and keyboard selection. Query parsing,
// filtering, and token replacement remain in Rust.
export component SearchBox inherits Rectangle {
    in property <string> text;
    in property <[SearchSuggestion]> suggestions;
    callback edited(string /* query */);
    callback suggestion-selected(string /* query */);

    private property <int> highlighted-index: 0;
    private property <int> visible-rows: 7;

    min-height: Layout.touch-target;

    function kind-label(kind: SearchSuggestionKind) -> string {
        if kind == SearchSuggestionKind.due {
            return @tr("SearchSuggestion" => "Due date");
        } else if kind == SearchSuggestionKind.project {
            return @tr("SearchSuggestion" => "Project");
        } else if kind == SearchSuggestionKind.task-list {
            return @tr("SearchSuggestion" => "Task list");
        } else if kind == SearchSuggestionKind.account {
            return @tr("SearchSuggestion" => "Account");
        }
        return @tr("SearchSuggestion" => "Tag");
    }

    function choose(index: int) {
        if index < 0 || index >= root.suggestions.length {
            return;
        }
        root.suggestion-selected(root.suggestions[index].query);
        suggestions-popup.close();
    }

    // The glyph sits beside the field rather than inside the placeholder, so
    // the translated string stays plain text.
    HorizontalLayout {
        width: 100%;
        height: 100%;
        spacing: Theme.space-xs;

        Icon {
            name: IconName.search;
            y: (parent.height - self.height) / 2;
        }

        field := LineEdit {
            private property <int> focus-search-request: AppState.focus-search-request;
            init => {
                if (self.focus-search-request > 0) { self.focus(); }
            }
            changed focus-search-request => { self.focus(); }
            horizontal-stretch: 1;
            height: 100%;
            placeholder-text: @tr("Sidebar" => "Search");
            accessible-label: @tr("Sidebar" => "Search tasks");
            text: root.text;

            edited(value) => {
                root.highlighted-index = 0;
                root.edited(value);
                if root.suggestions.length > 0 {
                    suggestions-popup.show();
                } else {
                    suggestions-popup.close();
                }
            }

            accepted(value) => {
                if suggestions-popup.is-open && root.suggestions.length > 0 {
                    root.choose(root.highlighted-index);
                }
            }

            key-pressed(event) => {
                if event.text == Key.Escape && suggestions-popup.is-open {
                    suggestions-popup.close();
                    return accept;
                } else if event.text == Key.UpArrow && root.suggestions.length > 0 {
                    root.highlighted-index = Math.max(root.highlighted-index - 1, 0);
                    suggestions-popup.show();
                    return accept;
                } else if event.text == Key.DownArrow && root.suggestions.length > 0 {
                    root.highlighted-index = Math.min(
                        root.highlighted-index + 1,
                        root.suggestions.length - 1,
                    );
                    suggestions-popup.show();
                    return accept;
                }
                return reject;
            }
        }
    }

    suggestions-popup := PopupWindow {
        x: 0px;
        y: root.height;
        width: root.width;
        height: Math.min(root.suggestions.length, root.visible-rows) * Layout.touch-target
            + 2 * Theme.space-xs;
        close-policy: close-on-click-outside;

        Rectangle {
            border-radius: Theme.radius-sm;
            border-width: 1px;
            border-color: Theme.border;
            background: Theme.surface-raised;
            clip: true;

            ListView {
                x: Theme.space-xs;
                y: Theme.space-xs;
                width: parent.width - 2 * Theme.space-xs;
                height: parent.height - 2 * Theme.space-xs;

                for suggestion[index] in root.suggestions: Rectangle {
                    height: Layout.touch-target;
                    border-radius: Theme.radius-sm;
                    background: index == root.highlighted-index
                        ? Theme.surface-selected
                        : suggestion-touch.has-hover ? Theme.surface-hover : transparent;

                    HorizontalLayout {
                        padding-left: Theme.space-sm;
                        padding-right: Theme.space-sm;
                        spacing: Theme.space-sm;

                        Text {
                            text: suggestion.replacement;
                            color: Theme.text;
                            font-size: Theme.font-size-base;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }

                        Text {
                            text: root.kind-label(suggestion.kind);
                            color: Theme.text-muted;
                            font-size: Theme.font-size-sm;
                            vertical-alignment: center;
                        }
                    }

                    suggestion-touch := TouchArea {
                        clicked => { root.choose(index); }
                    }
                    accessible-role: button;
                    accessible-label: @tr(
                        "SearchSuggestion" => "Use search suggestion {0}",
                        suggestion.replacement
                    );
                    accessible-action-default => { suggestion-touch.clicked(); }
                }
            }
        }
    }
}
