import { LineEdit, ListView } from "std-widgets.slint";
import { Theme } from "../../globals/theme.slint";
import { Layout } from "../../globals/layout.slint";
import { AppState } from "../../globals/app-state.slint";
import { Actions } from "../../globals/actions.slint";
import { SearchSuggestion, SearchSuggestionKind } from "../../globals/types.slint";
import { Icon, IconName } from "../../components/icon.slint";

// One row of the suggestion or disambiguation list.
component SuggestionRow inherits Rectangle {
    in property <SearchSuggestion> suggestion;
    in property <bool> highlighted;
    callback chosen();

    height: Layout.touch-target;
    border-radius: Theme.radius-sm;
    background: root.highlighted ? Theme.surface-selected
        : touch.has-hover ? Theme.surface-hover
        : transparent;

    function kind-label(kind: SearchSuggestionKind) -> string {
        if kind == SearchSuggestionKind.due {
            return @tr("SearchSuggestion" => "Due date");
        } else if kind == SearchSuggestionKind.status {
            return @tr("SearchSuggestion" => "State");
        } else if kind == SearchSuggestionKind.project {
            return @tr("SearchSuggestion" => "Project");
        } else if kind == SearchSuggestionKind.task-list {
            return @tr("SearchSuggestion" => "Task list");
        } else if kind == SearchSuggestionKind.user {
            return @tr("SearchSuggestion" => "User");
        }
        return @tr("SearchSuggestion" => "Tag");
    }

    // What tells two same-named candidates apart.
    function detail-text() -> string {
        if root.suggestion.kind == SearchSuggestionKind.project {
            return root.suggestion.archived
                ? @tr("SearchSuggestion" => "{0} lists, archived", root.suggestion.count)
                : @tr("SearchSuggestion" => "{0} lists", root.suggestion.count);
        }
        if root.suggestion.kind == SearchSuggestionKind.task-list
            || root.suggestion.kind == SearchSuggestionKind.user {
            return root.suggestion.detail;
        }
        return "";
    }

    HorizontalLayout {
        padding-left: Theme.space-sm;
        padding-right: Theme.space-sm;
        spacing: Theme.space-sm;

        if root.suggestion.has-color: Rectangle {
            width: 8px;
            height: 8px;
            y: (parent.height - self.height) / 2;
            border-radius: 4px;
            background: root.suggestion.color-brush;
        }

        Text {
            text: root.suggestion.label;
            color: Theme.text;
            font-size: Theme.font-size-base;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }

        if root.detail-text() != "": Text {
            text: root.detail-text();
            color: Theme.text-muted;
            font-size: Theme.font-size-sm;
            vertical-alignment: center;
            overflow: elide;
        }

        Text {
            text: root.kind-label(root.suggestion.kind);
            color: Theme.text-muted;
            font-size: Theme.font-size-sm;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        clicked => { root.chosen(); }
    }
    accessible-role: button;
    accessible-label: @tr("SearchSuggestion" => "Use search suggestion {0}", root.suggestion.label);
    accessible-action-default => { root.chosen(); }
}

// A scrolling list of suggestions under the search field.
component SuggestionList inherits Rectangle {
    in property <[SearchSuggestion]> items;
    in property <int> highlighted-index;
    in property <string> heading;
    in property <int> visible-rows: 7;
    callback chosen(int);

    // Keeps the row picked with the arrow keys inside the visible part.
    changed highlighted-index => {
        if root.highlighted-index * Layout.touch-target + list.viewport-y < 0px {
            list.viewport-y = -root.highlighted-index * Layout.touch-target;
        } else if (root.highlighted-index + 1) * Layout.touch-target + list.viewport-y > list.visible-height {
            list.viewport-y = list.visible-height - (root.highlighted-index + 1) * Layout.touch-target;
        }
    }

    border-radius: Theme.radius-sm;
    border-width: 1px;
    border-color: Theme.border;
    background: Theme.surface-raised;
    clip: true;

    VerticalLayout {
        padding: Theme.space-xs;
        spacing: 0px;

        if root.heading != "": Text {
            text: root.heading;
            color: Theme.text-muted;
            font-size: Theme.font-size-sm;
            height: Layout.touch-target * 0.75;
            vertical-alignment: center;
        }

        list := ListView {
            height: Math.min(root.items.length, root.visible-rows) * Layout.touch-target;

            for item[index] in root.items: SuggestionRow {
                suggestion: item;
                highlighted: index == root.highlighted-index;
                chosen => { root.chosen(index); }
            }
        }
    }
}

// Search input with candidates supplied by the ViewModel.
//
// The view owns only presentation and keyboard selection. Parsing, name
// resolution and token replacement stay in Rust, which also keeps what each
// confirmed `@` token points at.
//
// The candidate lists are drawn inline under the field rather than in a
// `PopupWindow`: a popup takes keyboard focus when it opens, which would pull
// the caret out of the field mid-word. Inline, the field keeps focus, so Left
// and Right move the caret while Up and Down move through the list.
export component SearchBox inherits VerticalLayout {
    in-out property <string> text;
    in property <[SearchSuggestion]> suggestions;
    in property <[SearchSuggestion]> candidates;

    private property <int> highlighted-index: 0;
    // Hidden with Escape or after a pick; the next keystroke shows it again.
    private property <bool> suggestions-open: false;
    private property <bool> candidates-open: false;
    private property <bool> showing-suggestions: root.suggestions-open
        && !root.showing-candidates
        && root.suggestions.length > 0;
    private property <bool> showing-candidates: root.candidates-open && root.candidates.length > 0;
    private property <int> candidates-request: AppState.search-candidates-request;
    private property <int> caret-request: AppState.search-caret-request;
    private property <bool> has-warning: AppState.search-unresolved != ""
        || AppState.search-ambiguous != ""
        || AppState.search-syntax-issue;

    spacing: Theme.space-xs;

    // The disambiguation list opens when Rust reports that a name fits several
    // targets, or when the warning is pressed to reopen it.
    changed candidates-request => {
        root.highlighted-index = 0;
        root.candidates-open = true;
    }

    // Rust rewrote the query (a sidebar item, a picked suggestion).
    changed caret-request => {
        field.set-selection-offsets(2147483647, 2147483647);
    }

    function choose-suggestion(index: int) {
        if index < 0 || index >= root.suggestions.length {
            return;
        }
        root.suggestions-open = false;
        Actions.search-suggestion-chosen(index);
    }

    function choose-candidate(index: int) {
        if index < 0 || index >= root.candidates.length {
            return;
        }
        root.candidates-open = false;
        Actions.search-candidate-chosen(index);
    }

    function list-length() -> int {
        return root.showing-candidates ? root.candidates.length
            : root.showing-suggestions ? root.suggestions.length
            : 0;
    }

    // The glyph sits beside the field rather than inside the placeholder, so
    // the translated string stays plain text.
    HorizontalLayout {
        min-height: Layout.touch-target;
        spacing: Theme.space-xs;

        Icon {
            name: IconName.search;
            y: (parent.height - self.height) / 2;
        }

        field := LineEdit {
            private property <int> focus-search-request: AppState.focus-search-request;
            init => {
                if (self.focus-search-request > 0) { self.focus(); }
            }
            changed focus-search-request => { self.focus(); }
            horizontal-stretch: 1;
            placeholder-text: @tr("Sidebar" => "Search");
            accessible-label: @tr("Sidebar" => "Search tasks");
            text <=> root.text;

            edited(value) => {
                root.highlighted-index = 0;
                root.suggestions-open = true;
                Actions.search-changed(value);
            }

            accepted(value) => {
                if root.showing-candidates {
                    root.choose-candidate(root.highlighted-index);
                } else if root.showing-suggestions {
                    root.choose-suggestion(root.highlighted-index);
                } else {
                    Actions.search-committed();
                }
            }

            // Only the keys the lists need are taken; everything else, the
            // caret movement included, stays with the field.
            key-pressed(event) => {
                if event.text == Key.Escape && root.showing-candidates {
                    root.candidates-open = false;
                    Actions.search-candidates-dismissed();
                    return accept;
                } else if event.text == Key.Escape && root.showing-suggestions {
                    root.suggestions-open = false;
                    return accept;
                } else if event.text == Key.UpArrow && root.list-length() > 0 {
                    root.highlighted-index = Math.max(root.highlighted-index - 1, 0);
                    return accept;
                } else if event.text == Key.DownArrow && root.list-length() > 0 {
                    root.highlighted-index = Math.min(root.highlighted-index + 1, root.list-length() - 1);
                    return accept;
                }
                return reject;
            }
        }

        // Part of the query was ignored or still fits several targets.
        if root.has-warning: Rectangle {
            width: Layout.touch-target;
            border-radius: Theme.radius-sm;
            background: warning-touch.has-hover ? Theme.surface-hover : transparent;

            Icon {
                name: IconName.warning;
                tint: Theme.priority-medium;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }

            warning-touch := TouchArea {
                clicked => { Actions.search-candidates-reopened(); }
            }
            accessible-role: button;
            accessible-label: AppState.search-ambiguous != ""
                ? @tr("Sidebar" => "Choose what {0} means", AppState.search-ambiguous)
                : @tr("Sidebar" => "Part of the search was ignored");
            accessible-action-default => { Actions.search-candidates-reopened(); }
        }
    }

    if root.showing-suggestions: SuggestionList {
        items: root.suggestions;
        highlighted-index: root.highlighted-index;
        chosen(index) => { root.choose-suggestion(index); }
    }

    if root.showing-candidates: SuggestionList {
        items: root.candidates;
        highlighted-index: root.highlighted-index;
        heading: @tr("SearchSuggestion" => "{0} matches several items", AppState.search-ambiguous);
        chosen(index) => { root.choose-candidate(index); }
    }

    // Says what the warning icon is about, in words.
    if root.has-warning && !root.showing-candidates: Text {
        text: AppState.search-ambiguous != ""
            ? @tr("Sidebar" => "Several matches for {0}. Choose one from the list.", AppState.search-ambiguous)
            : AppState.search-unresolved != ""
                ? @tr("Sidebar" => "Not found, ignored: {0}", AppState.search-unresolved)
                : @tr("Sidebar" => "An unmatched ) or | was ignored.");
        color: Theme.text-muted;
        font-size: Theme.font-size-sm;
        wrap: word-wrap;
    }
}
