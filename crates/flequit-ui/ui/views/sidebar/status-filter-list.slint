import { Theme } from "../../globals/theme.slint";
import { Layout } from "../../globals/layout.slint";
import { AppState } from "../../globals/app-state.slint";
import { Actions } from "../../globals/actions.slint";
import { FilterKind, QueryEdit } from "../../globals/types.slint";
import { Icon, IconName } from "../../components/icon.slint";
import { FilterStyle, FilterTarget } from "../../components/filter-target.slint";

// "Open" and "Completed": the empty query shows finished tasks too, and these
// narrow it in one click.
export component StatusFilterList inherits VerticalLayout {
    in property <bool> collapsed: false;

    spacing: 2px;

    function label(key: string) -> string {
        return key == "completed" ? @tr("StatusFilter" => "Completed") : @tr("StatusFilter" => "Open");
    }

    for filter in AppState.status-filters: Rectangle {
        height: Layout.touch-target;
        border-radius: Theme.radius-sm;
        background: FilterStyle.background(filter.highlight, target.has-hover);

        target := FilterTarget {
            highlight: filter.highlight;
            activated(edit) => { Actions.apply-filter(FilterKind.status, filter.key, edit); }

            HorizontalLayout {
                padding-left: Theme.space-sm;
                padding-right: Theme.space-sm;
                spacing: Theme.space-sm;

                Icon {
                    name: filter.key == "completed" ? IconName.check : IconName.circle;
                    y: (parent.height - self.height) / 2;
                }

                if !root.collapsed: Text {
                    text: root.label(filter.key);
                    color: Theme.text;
                    font-size: Theme.font-size-base;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }

                if !root.collapsed && filter.count > 0: Text {
                    text: filter.count;
                    color: Theme.text-muted;
                    font-size: Theme.font-size-sm;
                    vertical-alignment: center;
                }
            }
        }

        accessible-role: button;
        accessible-label: root.label(filter.key);
        accessible-action-default => { Actions.apply-filter(FilterKind.status, filter.key, QueryEdit.click); }
    }
}
