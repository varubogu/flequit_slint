import { Theme } from "../../globals/theme.slint";
import { Layout } from "../../globals/layout.slint";
import { AppState } from "../../globals/app-state.slint";
import { I18n } from "../../globals/i18n.slint";
import { Actions } from "../../globals/actions.slint";
import { FilterKind, QueryEdit } from "../../globals/types.slint";
import { Icon, IconName } from "../../components/icon.slint";
import { FilterStyle, FilterTarget } from "../../components/filter-target.slint";

// The due-date filter buttons at the top of the sidebar.
//
// Each button writes its keyword into the search box, so the filters and a
// typed query are the same mechanism.
export component DueFilterList inherits VerticalLayout {
    in property <bool> collapsed: false;

    spacing: 2px;

    for filter in AppState.due-filters: Rectangle {
        visible: filter.visible;
        height: filter.visible ? Layout.touch-target : 0px;
        border-radius: Theme.radius-sm;
        background: FilterStyle.background(filter.highlight, target.has-hover);

        target := FilterTarget {
            highlight: filter.highlight;
            activated(edit) => { Actions.apply-filter(FilterKind.due, filter.key, edit); }

            HorizontalLayout {
                padding-left: Theme.space-sm;
                padding-right: Theme.space-sm;
                spacing: Theme.space-sm;

                Icon {
                    name: IconName.clock;
                    y: (parent.height - self.height) / 2;
                }

                if !root.collapsed: Text {
                    text: filter.name != "" ? filter.name
                        : I18n.due-filter-label(filter.key, filter.custom-value, filter.custom-unit);
                    color: Theme.text;
                    font-size: Theme.font-size-base;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }

                if !root.collapsed && filter.count > 0: Text {
                    text: filter.count;
                    color: Theme.text-muted;
                    font-size: Theme.font-size-sm;
                    vertical-alignment: center;
                }
            }
        }

        accessible-role: button;
        accessible-label: filter.name != "" ? filter.name
            : I18n.due-filter-label(filter.key, filter.custom-value, filter.custom-unit);
        accessible-action-default => { Actions.apply-filter(FilterKind.due, filter.key, QueryEdit.click); }
    }
}
