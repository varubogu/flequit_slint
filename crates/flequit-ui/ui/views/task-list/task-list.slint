import { ListView, LineEdit } from "std-widgets.slint";
import { Theme } from "../../globals/theme.slint";
import { Layout } from "../../globals/layout.slint";
import { AppState } from "../../globals/app-state.slint";
import { Actions } from "../../globals/actions.slint";
import { TaskRow } from "../../components/task-row.slint";

// Task list pane.
//
// Uses ListView so the row count can grow without cost; rows are recycled.
export component TaskListView inherits Rectangle {
    background: Theme.background;

    VerticalLayout {
        spacing: 0px;

        ListView {
            vertical-stretch: 1;

            for task in AppState.tasks: TaskRow {
                task: task;
                selected: AppState.selected-task-id == task.id;
                clicked => { Actions.select-task(task.id); }
                toggle-completed => { Actions.toggle-task-completed(task.id); }
                toggle-expansion => { Actions.toggle-task-expansion(task.id); }
                subtask-clicked(id) => { Actions.select-subtask(id); }
                subtask-toggled(id) => { Actions.toggle-subtask-completed(id); }
            }
        }

        if AppState.tasks.length == 0 && !AppState.loading: Rectangle {
            vertical-stretch: 1;
            Text {
                text: @tr("TaskList" => "No tasks here yet.");
                color: Theme.text-muted;
                font-size: Theme.font-size-base;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%;
                height: 100%;
            }
        }

        // Quick add. Enabled only when a list is selected, since a task
        // needs a parent list.
        Rectangle {
            height: Layout.touch-target + 2 * Theme.space-sm;
            background: Theme.surface;

            HorizontalLayout {
                padding: Theme.space-sm;
                spacing: Theme.space-sm;

                new-task := LineEdit {
                    horizontal-stretch: 1;
                    enabled: AppState.selected-list-id != "";
                    placeholder-text: AppState.selected-list-id == ""
                        ? @tr("TaskList" => "Select a list to add a task")
                        : @tr("TaskList" => "Add a task");
                    accepted(value) => {
                        if (value != "") {
                            Actions.add-task(AppState.selected-list-id, value);
                            self.text = "";
                        }
                    }
                }

                Rectangle {
                    width: Layout.touch-target;
                    height: Layout.touch-target;
                    border-radius: Theme.radius-sm;
                    background: AppState.selected-list-id == "" ? Theme.border : Theme.accent;

                    Text {
                        text: "+";
                        color: Theme.text-on-accent;
                        font-size: Theme.font-size-lg;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }

                    TouchArea {
                        enabled: AppState.selected-list-id != "";
                        clicked => {
                            if (new-task.text != "") {
                                Actions.add-task(AppState.selected-list-id, new-task.text);
                                new-task.text = "";
                            }
                        }
                    }
                    accessible-role: button;
                    accessible-label: @tr("TaskList" => "Add a task");
                    accessible-action-default => {
                        if (new-task.text != "") {
                            Actions.add-task(AppState.selected-list-id, new-task.text);
                            new-task.text = "";
                        }
                    }
                }
            }
        }
    }
}
