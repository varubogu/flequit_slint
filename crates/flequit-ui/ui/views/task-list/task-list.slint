import { ListView, LineEdit } from "std-widgets.slint";
import { Theme } from "../../globals/theme.slint";
import { Layout } from "../../globals/layout.slint";
import { AppState } from "../../globals/app-state.slint";
import { Actions } from "../../globals/actions.slint";
import { SettingsState } from "../../globals/settings.slint";
import { EditorKind, Pane, TaskItem, TaskSort } from "../../globals/types.slint";
import { DialogButton } from "../../components/dialog-button.slint";
import { TaskRow } from "../../components/task-row.slint";
import { Icon, IconName } from "../../components/icon.slint";
import { TaskSortBar } from "task-sort-bar.slint";
import { AddTargetPicker } from "add-target-picker.slint";

// Task list pane.
//
// Uses ListView so the row count can grow without cost; rows are recycled.
export component TaskListView inherits Rectangle {
    background: Theme.background;
    forward-focus: keyboard-focus;

    private property <int> focus-list-request: AppState.focus-list-request;

    changed focus-list-request => { keyboard-focus.focus(); }

    // Reordering rewrites the stored order, which is only what the list shows
    // while it is sorted manually. The derived orderings ignore it.
    private property <bool> reorderable: AppState.task-sort == TaskSort.manual;

    // A drop inside the list, rather than on a list in the sidebar.
    private property <bool> reordering: AppState.is-dragging
        && AppState.drop-list-id == ""
        && root.reorderable;

    // Where the pointer currently is, as a row index. Rows are assumed to be
    // uniform, the same approximation the scroll-into-view code makes.
    private property <int> drop-index: task-list.estimated-row-height <= 0px
        ? 0
        : Math.clamp(
            Math.floor((AppState.drag-y - task-list.absolute-position.y
                - task-list.viewport-y) / task-list.estimated-row-height),
            0,
            AppState.tasks.length - 1);

    function start-drag(task: TaskItem, x: length, y: length) {
        AppState.dragging-task-id = task.id;
        AppState.dragging-project-id = task.project-id;
        AppState.drop-list-id = "";
        AppState.drag-x = x;
        AppState.drag-y = y;
    }

    function finish-drag(task-id: string, index: int) {
        if (AppState.drop-list-id != "") {
            Actions.move-task-to-list(task-id, AppState.drop-list-id);
        } else if (root.reordering && root.drop-index != index) {
            Actions.reorder-task(task-id, root.drop-index);
        }
        AppState.dragging-task-id = "";
        AppState.dragging-project-id = "";
        AppState.drop-list-id = "";
    }

    function create-project() {
        AppState.editor = {
            kind: EditorKind.project,
            target-id: "",
            project-id: "",
            name: "",
            color: "",
            archived: false,
        };
        AppState.editor-open = true;
    }

    function create-task-list() {
        AppState.editor = {
            kind: EditorKind.task-list,
            target-id: "",
            project-id: AppState.selected-project-id,
            name: "",
            color: "",
            archived: false,
        };
        AppState.editor-open = true;
    }

    keyboard-focus := FocusScope {
        width: 100%;
        height: 100%;

        init => {
            if (root.focus-list-request > 0) { self.focus(); }
        }

        key-pressed(event) => {
            if (event.text == Key.UpArrow
                || (SettingsState.vim-mode && event.text == "k")) {
                Actions.move-task-selection(-1);
                return accept;
            } else if (event.text == Key.DownArrow
                || (SettingsState.vim-mode && event.text == "j")) {
                Actions.move-task-selection(1);
                return accept;
            } else if (event.text == Key.Home
                || (SettingsState.vim-mode && event.text == "g")) {
                Actions.select-task-boundary(true);
                return accept;
            } else if (event.text == Key.End
                || (SettingsState.vim-mode && event.text == "G")) {
                Actions.select-task-boundary(false);
                return accept;
            } else if (event.text == Key.Return && AppState.has-selected-task) {
                AppState.active-pane = Pane.detail;
                AppState.focus-detail-request += 1;
                return accept;
            } else if (event.text == " " && AppState.selected-task-id != "") {
                Actions.toggle-task-completed(AppState.selected-task-id);
                return accept;
            } else if (event.text == Key.LeftArrow) {
                if (Layout.is-compact || Layout.is-medium) {
                    AppState.sidebar-open = true;
                } else {
                    AppState.sidebar-collapsed = false;
                }
                AppState.focus-search-request += 1;
                return accept;
            } else if (event.text == Key.RightArrow && AppState.has-selected-task) {
                AppState.active-pane = Pane.detail;
                AppState.focus-detail-request += 1;
                return accept;
            }
            return reject;
        }

        VerticalLayout {
            spacing: 0px;
            padding-left: Layout.content-safe-area-left;
            padding-right: Layout.content-safe-area-right;

        TaskSortBar { }

        task-list := ListView {
            vertical-stretch: 1;

            private property <int> scroll-request: AppState.scroll-to-index;
            private property <length> estimated-row-height:
                AppState.tasks.length > 0 ? self.viewport-height / AppState.tasks.length : 0px;
            private property <length> requested-row-y:
                self.viewport-y + self.scroll-request * self.estimated-row-height;

            changed scroll-request => {
                if (self.scroll-request >= 0 && self.scroll-request < AppState.tasks.length) {
                    if (self.requested-row-y < 0px) {
                        self.viewport-y += 0px - self.requested-row-y;
                    }

                    if (self.requested-row-y + self.estimated-row-height > self.visible-height) {
                        self.viewport-y -= self.requested-row-y
                            + self.estimated-row-height - self.visible-height;
                    }
                }

                if (self.scroll-request >= 0) {
                    AppState.scroll-to-index = -1;
                }
            }

            for task[index] in AppState.tasks: TaskRow {
                task: task;
                selected: AppState.selected-task-id == task.id;
                dragging: AppState.dragging-task-id == task.id;
                drop-before: root.reordering && root.drop-index == index;
                clicked => { Actions.select-task(task.id); }
                toggle-completed => { Actions.toggle-task-completed(task.id); }
                toggle-expansion => { Actions.toggle-task-expansion(task.id); }
                subtask-clicked(id) => { Actions.select-subtask(id); }
                subtask-toggled(id) => { Actions.toggle-subtask-completed(id); }
                drag-started(x, y) => { root.start-drag(task, x, y); }
                dragged(x, y) => {
                    AppState.drag-x = x;
                    AppState.drag-y = y;
                }
                drag-finished => { root.finish-drag(task.id, index); }
                move-earlier => {
                    if (root.reorderable) { Actions.reorder-task(task.id, index - 1); }
                }
                move-later => {
                    if (root.reorderable) { Actions.reorder-task(task.id, index + 1); }
                }
            }
        }

        if AppState.tasks.length == 0 && !AppState.loading: Rectangle {
            vertical-stretch: 1;

            VerticalLayout {
                padding: Layout.content-padding;
                spacing: Theme.space-md;
                alignment: center;

                Text {
                    text: AppState.search-query != ""
                        ? @tr("TaskList" => "No tasks match your search.")
                        : AppState.projects.length == 0
                            ? @tr("TaskList" => "Create a project to get started.")
                            : AppState.add-target-list-id == ""
                                ? @tr("TaskList" => "Create a task list to add tasks to.")
                                : @tr("TaskList" => "Add your first task.");
                    color: Theme.text-muted;
                    font-size: Theme.font-size-base;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }

                if AppState.search-query != "": DialogButton {
                    label: @tr("TaskList" => "Clear search");
                    clicked => {
                        AppState.search-query = "";
                        Actions.search-changed("");
                    }
                }

                if AppState.search-query == "" && AppState.projects.length == 0: DialogButton {
                    label: @tr("TaskList" => "Create project");
                    primary: true;
                    clicked => { root.create-project(); }
                }

                if AppState.search-query == ""
                    && AppState.projects.length > 0
                    && AppState.add-target-list-id == "": DialogButton {
                    label: @tr("TaskList" => "Create task list");
                    primary: true;
                    clicked => { root.create-task-list(); }
                }

                if AppState.search-query == "" && AppState.add-target-list-id != "": DialogButton {
                    label: @tr("TaskList" => "Add your first task");
                    primary: true;
                    clicked => { new-task.focus(); }
                }
            }
        }

        // Quick add. The list shows whatever the search finds, so the list a
        // new task goes to is picked explicitly, beside the field.
        Rectangle {
            height: Layout.touch-target + 2 * Theme.space-sm;
            background: Theme.surface;

            HorizontalLayout {
                padding: Theme.space-sm;
                spacing: Theme.space-sm;

                AddTargetPicker {
                    max-width: 240px;
                }

                new-task := LineEdit {
                    private property <int> focus-new-task-request: AppState.focus-new-task-request;
                    init => {
                        if (self.focus-new-task-request > 0 && self.enabled) { self.focus(); }
                    }
                    changed focus-new-task-request => {
                        if (self.enabled) { self.focus(); }
                    }
                    horizontal-stretch: 1;
                    enabled: AppState.add-target-list-id != "";
                    placeholder-text: AppState.add-target-list-id == ""
                        ? @tr("TaskList" => "Select a list to add a task")
                        : @tr("TaskList" => "Add a task");
                    accepted(value) => {
                        if (value != "") {
                            Actions.add-task(AppState.add-target-list-id, value);
                            self.text = "";
                        }
                    }
                }

                Rectangle {
                    width: Layout.touch-target;
                    height: Layout.touch-target;
                    border-radius: Theme.radius-sm;
                    background: AppState.add-target-list-id == "" ? Theme.border : Theme.accent;

                    Icon {
                        name: IconName.plus;
                        tint: Theme.text-on-accent;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }

                    TouchArea {
                        enabled: AppState.add-target-list-id != "";
                        clicked => {
                            if (new-task.text != "") {
                                Actions.add-task(AppState.add-target-list-id, new-task.text);
                                new-task.text = "";
                            }
                        }
                    }
                    accessible-role: button;
                    accessible-label: @tr("TaskList" => "Add a task");
                    accessible-action-default => {
                        if (new-task.text != "") {
                            Actions.add-task(AppState.add-target-list-id, new-task.text);
                            new-task.text = "";
                        }
                    }
                }
            }
        }
        }
    }
}
