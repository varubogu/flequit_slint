import { ScrollView } from "std-widgets.slint";
import { Theme } from "../../globals/theme.slint";
import { Layout } from "../../globals/layout.slint";
import { AppState } from "../../globals/app-state.slint";
import { Actions } from "../../globals/actions.slint";
import { FocusRing } from "../../components/focus-ring.slint";

// One crumb of the destination path: the current choice, and a button that
// opens the alternatives.
component CrumbButton inherits Rectangle {
    in property <string> text;
    in property <bool> muted: false;
    in property <brush> dot: transparent;
    in property <bool> has-dot: false;
    in property <string> action-label;
    out property <bool> has-focus: key-focus.has-focus;

    callback clicked();

    min-width: Layout.touch-target;
    preferred-width: layout.preferred-width;
    height: Layout.touch-target;
    border-radius: Theme.radius-sm;
    background: touch.has-hover ? Theme.surface-hover : transparent;
    forward-focus: key-focus;

    layout := HorizontalLayout {
        padding-left: Theme.space-xs;
        padding-right: Theme.space-xs;
        spacing: Theme.space-xs;

        if root.has-dot: Rectangle {
            width: 8px;
            height: 8px;
            y: (parent.height - self.height) / 2;
            border-radius: 4px;
            background: root.dot;
        }

        Text {
            text: root.text;
            color: root.muted ? Theme.text-muted : Theme.text;
            font-size: Theme.font-size-sm;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }

        Text {
            text: "▾";
            color: Theme.text-muted;
            font-size: Theme.font-size-sm;
            vertical-alignment: center;
        }
    }

    key-focus := FocusScope {
        key-pressed(event) => {
            if (event.text == " " || event.text == "\n") {
                root.clicked();
                return accept;
            }
            reject
        }
    }

    if key-focus.has-focus: FocusRing {
        radius: root.border-radius;
    }

    touch := TouchArea {
        // Clicking a crumb moves keyboard focus onto it, so the quick-add bar
        // stays open while its destination is being changed.
        clicked => {
            key-focus.focus();
            root.clicked();
        }
    }
    accessible-role: button;
    accessible-label: root.action-label;
    accessible-action-default => { root.clicked(); }
}

// The frame of a crumb's list of alternatives. It opens upwards: the quick-add
// bar sits at the bottom of the pane.
component CrumbPopupFrame inherits Rectangle {
    border-radius: Theme.radius-sm;
    border-width: 1px;
    border-color: Theme.border;
    background: Theme.surface-raised;
    clip: true;
}

// One alternative in a crumb's list. The current choice takes the keyboard
// focus when the list opens, so Tab moves on from there.
component CrumbOption inherits Rectangle {
    in property <string> text;
    in property <bool> muted: false;
    in property <bool> selected: false;
    in property <brush> dot: transparent;
    in property <bool> has-dot: false;

    callback chosen();

    height: Layout.touch-target;
    border-radius: Theme.radius-sm;
    background: root.selected ? Theme.surface-selected
        : touch.has-hover ? Theme.surface-hover
        : transparent;
    forward-focus: key-focus;

    init => {
        if (root.selected) { key-focus.focus(); }
    }

    HorizontalLayout {
        padding-left: Theme.space-sm;
        padding-right: Theme.space-sm;
        spacing: Theme.space-sm;

        if root.has-dot: Rectangle {
            width: 8px;
            height: 8px;
            y: (parent.height - self.height) / 2;
            border-radius: 4px;
            background: root.dot;
        }

        Text {
            text: root.text;
            color: root.muted ? Theme.text-muted : Theme.text;
            font-size: Theme.font-size-base;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
    }

    key-focus := FocusScope {
        key-pressed(event) => {
            if (event.text == " " || event.text == "\n") {
                root.chosen();
                return accept;
            }
            reject
        }
    }

    if key-focus.has-focus: FocusRing {
        radius: root.border-radius;
    }

    touch := TouchArea {
        clicked => { root.chosen(); }
    }
    accessible-role: button;
    accessible-label: root.text;
    accessible-item-selected: root.selected;
    accessible-action-default => { root.chosen(); }
}

// The first crumb: the project.
component ProjectCrumb inherits CrumbButton {
    private property <int> visible-rows: 8;
    // Focused, or choosing from its list (which holds the focus meanwhile).
    out property <bool> engaged: self.has-focus || popup.is-open;

    text: AppState.add-target == ""
        ? @tr("TaskList" => "No project")
        : AppState.add-target-project-name;
    muted: AppState.add-target == "";
    dot: AppState.add-target-color;
    has-dot: AppState.add-target-has-color;
    action-label: AppState.add-target == ""
        ? @tr("TaskList" => "Choose where new tasks go")
        : @tr("TaskList" => "Project of new tasks: {0}. Change", AppState.add-target-project-name);

    clicked => {
        if (AppState.add-target-projects.length > 0) { popup.show(); }
    }

    popup := PopupWindow {
        x: 0px;
        y: -self.height - Theme.space-xs;
        width: Math.max(root.width, 240px);
        height: Math.min(AppState.add-target-projects.length, root.visible-rows)
            * Layout.touch-target + 2 * Theme.space-xs;
        close-policy: close-on-click-outside;

        CrumbPopupFrame {
            ScrollView {
                x: Theme.space-xs;
                y: Theme.space-xs;
                width: parent.width - 2 * Theme.space-xs;
                height: parent.height - 2 * Theme.space-xs;

                VerticalLayout {
                    for project in AppState.add-target-projects: CrumbOption {
                        text: project.name;
                        dot: project.color-brush;
                        has-dot: project.has-color;
                        selected: project.id == AppState.add-target-project-id;
                        chosen => {
                            Actions.choose-add-target-project(project.id);
                            popup.close();
                        }
                    }
                }
            }
        }
    }
}

// The second crumb: a list of the project, or none.
component PlaceCrumb inherits CrumbButton {
    private property <int> visible-rows: 8;
    // Focused, or choosing from its list (which holds the focus meanwhile).
    out property <bool> engaged: self.has-focus || popup.is-open;

    text: AppState.add-target-list-name == ""
        ? @tr("TaskList" => "No list")
        : AppState.add-target-list-name;
    muted: AppState.add-target-list-name == "";
    action-label: AppState.add-target-list-name == ""
        ? @tr("TaskList" => "New tasks belong to no list. Change")
        : @tr("TaskList" => "List of new tasks: {0}. Change", AppState.add-target-list-name);

    clicked => {
        if (AppState.add-targets.length > 0) { popup.show(); }
    }

    popup := PopupWindow {
        x: 0px;
        y: -self.height - Theme.space-xs;
        width: Math.max(root.width, 240px);
        height: Math.min(AppState.add-targets.length, root.visible-rows)
            * Layout.touch-target + 2 * Theme.space-xs;
        close-policy: close-on-click-outside;

        CrumbPopupFrame {
            ScrollView {
                x: Theme.space-xs;
                y: Theme.space-xs;
                width: parent.width - 2 * Theme.space-xs;
                height: parent.height - 2 * Theme.space-xs;

                VerticalLayout {
                    for place in AppState.add-targets: CrumbOption {
                        text: place.list-name == "" ? @tr("TaskList" => "No list") : place.list-name;
                        muted: place.list-name == "";
                        selected: place.key == AppState.add-target;
                        chosen => {
                            Actions.choose-add-target(place.key);
                            popup.close();
                        }
                    }
                }
            }
        }
    }
}

// Where the quick-add field adds to, as a path: `project › list`.
//
// The task list shows whatever the search finds, so it does not say where a
// new task belongs. The ViewModel picks a default from the query (the one list
// or project it narrows to, else the last place used); choosing here overrides
// that until the query points somewhere else. Each crumb is changed on its
// own: the project first, then a list of it or none at all.
export component AddTargetPicker inherits HorizontalLayout {
    // A crumb is focused or its list is open: the destination is being
    // changed, which counts as adding a task.
    out property <bool> engaged: project-crumb.engaged || place-crumb.engaged;

    spacing: 0px;
    alignment: start;

    project-crumb := ProjectCrumb { }

    Text {
        text: "›";
        color: Theme.text-muted;
        font-size: Theme.font-size-sm;
        vertical-alignment: center;
    }

    place-crumb := PlaceCrumb { }
}
