import { SpinBox } from "std-widgets.slint";
import { Theme } from "../../globals/theme.slint";
import { Layout } from "../../globals/layout.slint";
import { Actions } from "../../globals/actions.slint";
import { I18n } from "../../globals/i18n.slint";
import { SettingsState } from "../../globals/settings.slint";
import { ReminderUnit } from "../../globals/types.slint";
import { ChoiceButton } from "../../components/choice-button.slint";
import { DateTimePicker } from "../../components/date-time-picker.slint";
import { DialogButton } from "../../components/dialog-button.slint";

component ReminderOption inherits Rectangle {
    in property <string> label;
    callback selected();

    height: Layout.touch-target;
    horizontal-stretch: 1;
    border-radius: Theme.radius-sm;
    border-width: 1px;
    border-color: Theme.border;
    background: touch.has-hover ? Theme.surface-hover : Theme.surface;

    Text {
        x: Theme.space-xs;
        width: parent.width - 2 * Theme.space-xs;
        height: 100%;
        text: root.label;
        color: Theme.text;
        font-size: Theme.font-size-sm;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }

    touch := TouchArea { clicked => { root.selected(); } }
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.selected(); }
}

component SectionLabel inherits Text {
    color: Theme.text-muted;
    font-size: Theme.font-size-sm;
    wrap: word-wrap;
}

// Keeps direct calendar entry and relative offsets behind one add action.
// A specific date and time works on every task; relative offsets appear only
// for the task dates that are set: the due date alone, or either end of a
// period.
export component ReminderEditor inherits VerticalLayout {
    in property <string> task-id;
    in property <bool> has-start;
    in property <bool> has-due;
    // A period calls its second date the end rather than the due date.
    in property <bool> is-range;
    // Where the calendar opens.
    in property <int> year;
    in property <int> month;
    in property <int> day;
    in property <int> hour;
    in property <int> minute;

    private property <bool> editor-open: false;
    // Which end of a period the relative offsets count from; ignored unless
    // both ends are set.
    private property <bool> prefer-start: true;
    private property <bool> from-start: root.has-start && (!root.has-due || root.prefer-start);
    private property <bool> after: false;
    private property <ReminderUnit> custom-unit: ReminderUnit.minute;

    changed task-id => {
        root.editor-open = false;
        root.prefer-start = true;
        root.after = false;
    }

    vertical-stretch: 0;
    spacing: Theme.space-sm;

    DialogButton {
        label: @tr("TaskDetail" => "Add a reminder");
        primary: !root.editor-open;
        clicked => { root.editor-open = !root.editor-open; }
    }

    if root.editor-open: VerticalLayout {
        vertical-stretch: 0;
        spacing: Theme.space-sm;

        SectionLabel { text: @tr("TaskDetail" => "Date and time"); }

        DateTimePicker {
            value-label: "";
            has-value: false;
            allow-clear: false;
            year: root.year;
            month: root.month;
            day: root.day;
            hour: root.hour;
            minute: root.minute;
            edit-label: @tr("TaskDetail" => "Select a specific reminder date");
            date-title: @tr("TaskDetail" => "Select reminder date");
            selection-validation-enabled: true;
            invalid-selection-message: @tr("Reminder" => "Choose a future date and time.");
            date-selectable(year, month, day) => {
                return Actions.reminder-date-selectable(year, month, day);
            }
            selection-valid(year, month, day, hour, minute) => {
                return Actions.reminder-datetime-valid(year, month, day, hour, minute);
            }
            accepted(year, month, day, hour, minute) => {
                Actions.add-reminder(root.task-id, year, month, day, hour, minute);
                root.editor-open = false;
            }
        }

        if root.has-start || root.has-due: VerticalLayout {
            vertical-stretch: 0;
            spacing: Theme.space-sm;

            SectionLabel {
                text: root.has-start && root.has-due
                    ? @tr("TaskDetail" => "Relative to the start or end")
                    : root.has-start ? @tr("TaskDetail" => "Relative to the start")
                    : root.is-range ? @tr("TaskDetail" => "Relative to the end")
                    : @tr("TaskDetail" => "Relative to the due date");
            }

            if root.has-start && root.has-due: HorizontalLayout {
                vertical-stretch: 0;
                spacing: Theme.space-sm;
                ChoiceButton {
                    label: @tr("TaskDetail" => "Start");
                    action-label: @tr("TaskDetail" => "Count from the start");
                    selected: root.from-start;
                    clicked => { root.prefer-start = true; }
                }
                ChoiceButton {
                    label: @tr("TaskDetail" => "End");
                    action-label: @tr("TaskDetail" => "Count from the end");
                    selected: !root.from-start;
                    clicked => { root.prefer-start = false; }
                }
            }

            for preset in SettingsState.reminder-presets: ReminderOption {
                label: I18n.reminder-offset-label(preset.value, preset.unit);
                selected => {
                    Actions.add-relative-reminder(root.task-id, root.from-start,
                                                  preset.minutes-before);
                    root.editor-open = false;
                }
            }

            // Any other offset, before or after the selected date.
            HorizontalLayout {
                vertical-stretch: 0;
                spacing: Theme.space-sm;
                ChoiceButton {
                    label: @tr("Settings" => "Minutes");
                    action-label: @tr("TaskDetail" => "Count the offset in minutes");
                    selected: root.custom-unit == ReminderUnit.minute;
                    clicked => { root.custom-unit = ReminderUnit.minute; }
                }
                ChoiceButton {
                    label: @tr("Settings" => "Hours");
                    action-label: @tr("TaskDetail" => "Count the offset in hours");
                    selected: root.custom-unit == ReminderUnit.hour;
                    clicked => { root.custom-unit = ReminderUnit.hour; }
                }
                ChoiceButton {
                    label: @tr("Settings" => "Days");
                    action-label: @tr("TaskDetail" => "Count the offset in days");
                    selected: root.custom-unit == ReminderUnit.day;
                    clicked => { root.custom-unit = ReminderUnit.day; }
                }
            }

            HorizontalLayout {
                vertical-stretch: 0;
                spacing: Theme.space-sm;
                ChoiceButton {
                    label: @tr("TaskDetail" => "Before");
                    action-label: @tr("TaskDetail" => "Remind before the date");
                    selected: !root.after;
                    clicked => { root.after = false; }
                }
                ChoiceButton {
                    label: @tr("TaskDetail" => "After");
                    action-label: @tr("TaskDetail" => "Remind after the date");
                    selected: root.after;
                    clicked => { root.after = true; }
                }
            }

            HorizontalLayout {
                height: Layout.touch-target;
                vertical-stretch: 0;
                spacing: Theme.space-sm;
                offset-value := SpinBox {
                    height: Layout.touch-target;
                    horizontal-stretch: 1;
                    value: 30;
                    minimum: 1;
                    maximum: root.custom-unit == ReminderUnit.minute ? 43200
                        : root.custom-unit == ReminderUnit.hour ? 8760 : 3650;
                    accessible-label: @tr("TaskDetail" => "Reminder offset");
                }
                DialogButton {
                    label: @tr("TaskDetail" => "Add");
                    primary: true;
                    accessible-label: @tr("TaskDetail" => "Add the reminder with this offset");
                    clicked => {
                        Actions.add-relative-reminder(
                            root.task-id, root.from-start,
                            offset-value.value
                                * (root.custom-unit == ReminderUnit.minute ? 1
                                   : root.custom-unit == ReminderUnit.hour ? 60 : 1440)
                                * (root.after ? -1 : 1));
                        root.editor-open = false;
                    }
                }
            }
        }
    }
}
