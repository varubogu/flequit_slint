import { ScrollView, LineEdit, TextEdit } from "std-widgets.slint";
import { Theme } from "../../globals/theme.slint";
import { Layout } from "../../globals/layout.slint";
import { AppState } from "../../globals/app-state.slint";
import { Actions } from "../../globals/actions.slint";
import { Capabilities } from "../../globals/capabilities.slint";
import { TaskItem, TaskPriority, TaskStatus } from "../../globals/types.slint";
import { I18n } from "../../globals/i18n.slint";
import { IconButton } from "../../components/icon-button.slint";
import { DateTimePicker } from "../../components/date-time-picker.slint";
import { ChoiceButton } from "../../components/choice-button.slint";
import { Icon, IconName } from "../../components/icon.slint";


// Task detail pane.
//
// In the compact breakpoint this is a full-screen view reached from the list,
// so it shows a back affordance; the caller decides via `show-back`.
export component TaskDetailView inherits Rectangle {
    in property <bool> show-back: false;
    callback back();

    // The selected task, resolved by the caller from AppState.tasks.
    in property <TaskItem> task;
    in property <bool> has-task: false;

    background: Theme.background;

    if !root.has-task: Text {
        text: @tr("TaskDetail" => "Select a task to see its details.");
        color: Theme.text-muted;
        font-size: Theme.font-size-base;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: 100%;
        height: 100%;
    }

    if root.has-task: VerticalLayout {
        padding: Layout.content-padding;
        padding-top: Layout.content-padding + Layout.safe-area-top;
        padding-bottom: Layout.content-padding + Layout.safe-area-bottom;
        spacing: Theme.space-md;

        // Header
        HorizontalLayout {
            spacing: Theme.space-sm;

            if root.show-back: IconButton {
                icon: IconName.chevron-left;
                tooltip: @tr("TaskDetail" => "Back to list");
                clicked => { root.back(); }
            }

            Text {
                text: @tr("TaskDetail" => "Task");
                color: Theme.text-muted;
                font-size: Theme.font-size-sm;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }

            IconButton {
                icon: IconName.trash;
                tooltip: @tr("TaskDetail" => "Delete task");
                clicked => { Actions.delete-task(root.task.id); }
            }
        }

        ScrollView {
            vertical-stretch: 1;

            VerticalLayout {
                spacing: Theme.space-md;
                alignment: start;

                // Title
                LineEdit {
                    private property <int> focus-detail-request: AppState.focus-detail-request;
                    init => {
                        if (self.focus-detail-request > 0 && root.has-task) { self.focus(); }
                    }
                    changed focus-detail-request => {
                        if (root.has-task) { self.focus(); }
                    }
                    text: root.task.title;
                    font-size: Theme.font-size-title;
                    placeholder-text: @tr("TaskDetail" => "Task title");
                    edited(value) => { Actions.update-task-title(root.task.id, value); }
                }

                // Metadata
                VerticalLayout {
                    spacing: Theme.space-sm;

                    // A range task shows both ends; otherwise the single date is
                    // the deadline, which is how most tasks are entered.
                    HorizontalLayout {
                        spacing: Theme.space-sm;
                        Text {
                            text: @tr("TaskDetail" => "Period");
                            color: Theme.text-muted;
                            font-size: Theme.font-size-sm;
                            width: 80px;
                            vertical-alignment: center;
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                            height: Layout.touch-target;
                            border-radius: Theme.radius-sm;
                            border-width: 1px;
                            border-color: root.task.is-range-date ? Theme.accent : Theme.border;
                            background: root.task.is-range-date ? Theme.surface-selected
                                : range-touch.has-hover ? Theme.surface-hover
                                : Theme.surface;

                            Text {
                                x: Theme.space-sm;
                                width: parent.width - 2 * Theme.space-sm;
                                height: 100%;
                                text: root.task.is-range-date
                                    ? @tr("TaskDetail" => "Start and due date")
                                    : @tr("TaskDetail" => "Due date only");
                                color: Theme.text;
                                font-size: Theme.font-size-base;
                                vertical-alignment: center;
                                overflow: elide;
                            }

                            range-touch := TouchArea {
                                clicked => {
                                    Actions.set-task-range(root.task.id, !root.task.is-range-date);
                                }
                            }
                            accessible-role: switch;
                            accessible-checkable: true;
                            accessible-checked: root.task.is-range-date;
                            accessible-label: @tr("TaskDetail" => "Use a start and due date");
                            accessible-action-default => {
                                Actions.set-task-range(root.task.id, !root.task.is-range-date);
                            }
                        }
                    }

                    if root.task.is-range-date: HorizontalLayout {
                        spacing: Theme.space-sm;
                        Text {
                            text: @tr("TaskDetail" => "Start");
                            color: Theme.text-muted;
                            font-size: Theme.font-size-sm;
                            width: 80px;
                        }
                        DateTimePicker {
                            horizontal-stretch: 1;
                            value-label: root.task.start-label;
                            has-value: root.task.has-start;
                            year: root.task.start-year;
                            month: root.task.start-month;
                            day: root.task.start-day;
                            hour: root.task.start-hour;
                            minute: root.task.start-minute;
                            edit-label: @tr("TaskDetail" => "Edit start date");
                            clear-label: @tr("TaskDetail" => "Clear start date");
                            date-title: @tr("TaskDetail" => "Select start date");
                            time-title: @tr("TaskDetail" => "Select start time");
                            accepted(year, month, day, hour, minute) => {
                                Actions.update-task-start(root.task.id, year, month, day, hour, minute);
                            }
                            cleared => { Actions.clear-task-start(root.task.id); }
                        }
                    }

                    HorizontalLayout {
                        spacing: Theme.space-sm;
                        Text {
                            text: root.task.is-range-date
                                ? @tr("TaskDetail" => "End")
                                : @tr("TaskDetail" => "Due");
                            color: Theme.text-muted;
                            font-size: Theme.font-size-sm;
                            width: 80px;
                        }
                        DateTimePicker {
                            horizontal-stretch: 1;
                            value-label: root.task.due-label;
                            has-value: root.task.has-due;
                            year: root.task.due-year;
                            month: root.task.due-month;
                            day: root.task.due-day;
                            hour: root.task.due-hour;
                            minute: root.task.due-minute;
                            danger: root.task.overdue;
                            accepted(year, month, day, hour, minute) => {
                                Actions.update-task-due(root.task.id, year, month, day, hour, minute);
                            }
                            cleared => { Actions.clear-task-due(root.task.id); }
                        }
                    }

                    HorizontalLayout {
                        spacing: Theme.space-sm;
                        Text {
                            text: @tr("TaskDetail" => "Repeat");
                            color: Theme.text-muted;
                            font-size: Theme.font-size-sm;
                            width: 80px;
                            vertical-alignment: center;
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                            height: Layout.touch-target;
                            background: repeat-touch.has-hover ? Theme.surface-hover : Theme.surface;
                            border-radius: Theme.radius-sm;
                            border-width: 1px;
                            border-color: Theme.border;

                            Text {
                                x: Theme.space-sm;
                                width: parent.width - 2 * Theme.space-sm;
                                height: 100%;
                                text: root.task.has-recurrence
                                    ? I18n.recurrence-summary(root.task.recurrence-unit,
                                                              root.task.recurrence-interval)
                                    : @tr("TaskDetail" => "Does not repeat");
                                color: root.task.has-recurrence ? Theme.text : Theme.text-muted;
                                font-size: Theme.font-size-base;
                                vertical-alignment: center;
                                overflow: elide;
                            }

                            repeat-touch := TouchArea {
                                clicked => { Actions.open-recurrence(root.task.id); }
                            }
                            accessible-role: button;
                            accessible-label: @tr("TaskDetail" => "Edit the repeat schedule");
                            accessible-action-default => { Actions.open-recurrence(root.task.id); }
                        }
                    }

                    if Capabilities.local-notification: VerticalLayout {
                        spacing: Theme.space-sm;

                        Text {
                            text: @tr("TaskDetail" => "Reminders");
                            color: Theme.text-muted;
                            font-size: Theme.font-size-sm;
                        }

                        for reminder in root.task.reminders: Rectangle {
                            height: Layout.touch-target;
                            border-radius: Theme.radius-sm;
                            background: Theme.surface;

                            HorizontalLayout {
                                padding-left: Theme.space-sm;
                                spacing: Theme.space-sm;
                                Text {
                                    text: reminder.label;
                                    color: Theme.text;
                                    font-size: Theme.font-size-base;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                }
                                IconButton {
                                    icon: IconName.close;
                                    tooltip: @tr("TaskDetail" => "Remove reminder {0}", reminder.label);
                                    clicked => { Actions.remove-reminder(root.task.id, reminder.key); }
                                }
                            }
                        }

                        DateTimePicker {
                            value-label: "";
                            has-value: false;
                            allow-clear: false;
                            year: root.task.due-year;
                            month: root.task.due-month;
                            day: root.task.due-day;
                            hour: root.task.due-hour;
                            minute: root.task.due-minute;
                            edit-label: @tr("TaskDetail" => "Add a reminder");
                            date-title: @tr("TaskDetail" => "Select reminder date");
                            time-title: @tr("TaskDetail" => "Select reminder time");
                            accepted(year, month, day, hour, minute) => {
                                Actions.add-reminder(root.task.id, year, month, day, hour, minute);
                            }
                        }
                    }

                    VerticalLayout {
                        spacing: Theme.space-sm;
                        Text {
                            text: @tr("TaskDetail" => "Status");
                            color: Theme.text-muted;
                            font-size: Theme.font-size-sm;
                        }

                        HorizontalLayout {
                            spacing: Theme.space-xs;

                            ChoiceButton {
                                label: @tr("Status" => "Not started");
                                action-label: @tr("Status" => "Set status to {0}", self.label);
                                indicator-color: Theme.text-muted;
                                selected: root.task.status == TaskStatus.not-started;
                                clicked => { Actions.update-task-status(root.task.id, TaskStatus.not-started); }
                            }
                            ChoiceButton {
                                label: @tr("Status" => "In progress");
                                action-label: @tr("Status" => "Set status to {0}", self.label);
                                indicator-color: Theme.accent;
                                selected: root.task.status == TaskStatus.in-progress;
                                clicked => { Actions.update-task-status(root.task.id, TaskStatus.in-progress); }
                            }
                        }

                        HorizontalLayout {
                            spacing: Theme.space-xs;

                            ChoiceButton {
                                label: @tr("Status" => "Waiting");
                                action-label: @tr("Status" => "Set status to {0}", self.label);
                                indicator-color: Theme.warning;
                                selected: root.task.status == TaskStatus.waiting;
                                clicked => { Actions.update-task-status(root.task.id, TaskStatus.waiting); }
                            }
                            ChoiceButton {
                                label: @tr("Status" => "Completed");
                                action-label: @tr("Status" => "Set status to {0}", self.label);
                                indicator-color: Theme.success;
                                selected: root.task.status == TaskStatus.completed;
                                clicked => { Actions.update-task-status(root.task.id, TaskStatus.completed); }
                            }
                            ChoiceButton {
                                label: @tr("Status" => "Cancelled");
                                action-label: @tr("Status" => "Set status to {0}", self.label);
                                indicator-color: Theme.danger;
                                selected: root.task.status == TaskStatus.cancelled;
                                clicked => { Actions.update-task-status(root.task.id, TaskStatus.cancelled); }
                            }
                        }
                    }

                    VerticalLayout {
                        spacing: Theme.space-sm;
                        Text {
                            text: @tr("TaskDetail" => "Priority");
                            color: Theme.text-muted;
                            font-size: Theme.font-size-sm;
                        }
                        HorizontalLayout {
                            spacing: Theme.space-xs;

                            ChoiceButton {
                                label: @tr("Priority" => "None");
                                action-label: @tr("Priority" => "Set priority to {0}", self.label);
                                indicator-color: transparent;
                                selected: root.task.priority == TaskPriority.none;
                                clicked => { Actions.update-task-priority(root.task.id, TaskPriority.none); }
                            }
                            ChoiceButton {
                                label: @tr("Priority" => "Low");
                                action-label: @tr("Priority" => "Set priority to {0}", self.label);
                                indicator-color: Theme.priority-low;
                                selected: root.task.priority == TaskPriority.low;
                                clicked => { Actions.update-task-priority(root.task.id, TaskPriority.low); }
                            }
                            ChoiceButton {
                                label: @tr("Priority" => "Medium");
                                action-label: @tr("Priority" => "Set priority to {0}", self.label);
                                indicator-color: Theme.priority-medium;
                                selected: root.task.priority == TaskPriority.medium;
                                clicked => { Actions.update-task-priority(root.task.id, TaskPriority.medium); }
                            }
                            ChoiceButton {
                                label: @tr("Priority" => "High");
                                action-label: @tr("Priority" => "Set priority to {0}", self.label);
                                indicator-color: Theme.priority-high;
                                selected: root.task.priority == TaskPriority.high;
                                clicked => { Actions.update-task-priority(root.task.id, TaskPriority.high); }
                            }
                        }
                    }
                }

                // Notes
                Text {
                    text: @tr("TaskDetail" => "Notes");
                    color: Theme.text-muted;
                    font-size: Theme.font-size-sm;
                }

                TextEdit {
                    height: 160px;
                    text: root.task.notes;
                    wrap: word-wrap;
                    edited => { Actions.update-task-notes(root.task.id, self.text); }
                }

                Text {
                    text: @tr("TaskDetail" => "Tags");
                    color: Theme.text-muted;
                    font-size: Theme.font-size-sm;
                }

                VerticalLayout {
                    spacing: 2px;

                    for tag in AppState.tags: Rectangle {
                        height: Layout.touch-target;
                        border-radius: Theme.radius-sm;
                        background: tag.assigned ? Theme.surface-selected
                            : tag-touch.has-hover ? Theme.surface-hover
                            : Theme.surface;
                        border-width: tag.assigned ? 1px : 0px;
                        border-color: Theme.accent;

                        HorizontalLayout {
                            padding-left: Theme.space-sm;
                            padding-right: Theme.space-sm;
                            spacing: Theme.space-sm;

                            Rectangle {
                                width: 8px;
                                height: 8px;
                                border-radius: 4px;
                                background: tag.has-color ? tag.color-brush : Theme.accent;
                                y: (parent.height - self.height) / 2;
                            }

                            Text {
                                text: "#" + tag.name;
                                color: Theme.text;
                                font-size: Theme.font-size-base;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                overflow: elide;
                            }

                            Text {
                                text: tag.assigned ? "✓" : "+";
                                color: tag.assigned ? Theme.accent : Theme.text-muted;
                                font-size: Theme.font-size-base;
                                vertical-alignment: center;
                            }
                        }

                        tag-touch := TouchArea {
                            clicked => { Actions.set-task-tag(root.task.id, tag.id, !tag.assigned); }
                        }
                        accessible-role: button;
                        accessible-label: tag.assigned
                            ? @tr("TaskDetail" => "Remove tag {0} from {1}", tag.name, root.task.title)
                            : @tr("TaskDetail" => "Add tag {0} to {1}", tag.name, root.task.title);
                        accessible-action-default => {
                            Actions.set-task-tag(root.task.id, tag.id, !tag.assigned);
                        }
                    }

                    Rectangle {
                        height: Layout.touch-target;
                        background: Theme.surface;
                        border-radius: Theme.radius-sm;

                        HorizontalLayout {
                            spacing: Theme.space-sm;

                            new-tag := LineEdit {
                                horizontal-stretch: 1;
                                placeholder-text: @tr("TaskDetail" => "Add a tag");
                                accessible-label: @tr("TaskDetail" => "New tag name");
                                accepted(value) => {
                                    if (value != "") {
                                        Actions.add-task-tag(root.task.id, value);
                                        self.text = "";
                                    }
                                }
                            }

                            Rectangle {
                                width: Layout.touch-target;
                                height: Layout.touch-target;
                                border-radius: Theme.radius-sm;
                                background: Theme.accent;

                                Icon {
                                    name: IconName.plus;
                                    tint: Theme.text-on-accent;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                }

                                TouchArea {
                                    clicked => {
                                        if (new-tag.text != "") {
                                            Actions.add-task-tag(root.task.id, new-tag.text);
                                            new-tag.text = "";
                                        }
                                    }
                                }
                                accessible-role: button;
                                accessible-label: @tr("TaskDetail" => "Add tag");
                                accessible-action-default => {
                                    if (new-tag.text != "") {
                                        Actions.add-task-tag(root.task.id, new-tag.text);
                                        new-tag.text = "";
                                    }
                                }
                            }
                        }
                    }
                }

                // Subtasks
                Text {
                    text: @tr("TaskDetail" => "Subtasks");
                    color: Theme.text-muted;
                    font-size: Theme.font-size-sm;
                }

                for sub in root.task.subtasks: Rectangle {
                    height: Layout.touch-target;
                    border-radius: Theme.radius-sm;
                    background: sub-touch.has-hover ? Theme.surface-hover : transparent;

                    sub-touch := TouchArea {
                        clicked => { Actions.select-subtask(sub.id); }
                    }

                    HorizontalLayout {
                        padding-left: Theme.space-sm;
                        spacing: Theme.space-sm;

                        // Toggling completion must not open the subtask, so the
                        // checkbox gets its own hit area above the row's.
                        Rectangle {
                            width: Layout.touch-target;
                            Text {
                                text: sub.completed ? "☑" : "☐";
                                color: sub.completed ? Theme.accent : Theme.text-muted;
                                font-size: Theme.font-size-base;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                width: 100%;
                                height: 100%;
                            }
                            TouchArea {
                                clicked => { Actions.toggle-subtask-completed(sub.id); }
                            }
                            accessible-role: checkbox;
                            accessible-checkable: true;
                            accessible-checked: sub.completed;
                            accessible-label: @tr("TaskDetail" => "Complete {0}", sub.title);
                            accessible-action-default => { Actions.toggle-subtask-completed(sub.id); }
                        }

                        Text {
                            text: sub.title;
                            color: sub.completed ? Theme.text-muted : Theme.text;
                            font-size: Theme.font-size-base;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }

                        if sub.has-due: Text {
                            text: sub.due-label;
                            color: sub.overdue ? Theme.danger : Theme.text-muted;
                            font-size: Theme.font-size-sm;
                            vertical-alignment: center;
                        }

                        IconButton {
                            icon: IconName.trash;
                            tooltip: @tr("TaskDetail" => "Delete subtask {0}", sub.title);
                            clicked => { Actions.delete-subtask(sub.id); }
                        }
                    }

                    accessible-role: button;
                    accessible-label: @tr("TaskDetail" => "Open subtask {0}", sub.title);
                    accessible-action-default => { Actions.select-subtask(sub.id); }
                }

                Rectangle {
                    height: Layout.touch-target;
                    background: Theme.surface;
                    border-radius: Theme.radius-sm;

                    HorizontalLayout {
                        spacing: Theme.space-sm;

                        new-subtask := LineEdit {
                            horizontal-stretch: 1;
                            placeholder-text: @tr("TaskDetail" => "Add a subtask");
                            accessible-label: @tr("TaskDetail" => "New subtask title");
                            accepted(value) => {
                                if (value != "") {
                                    Actions.add-subtask(root.task.id, value);
                                    self.text = "";
                                }
                            }
                        }

                        Rectangle {
                            width: Layout.touch-target;
                            height: Layout.touch-target;
                            border-radius: Theme.radius-sm;
                            background: Theme.accent;

                            Icon {
                                name: IconName.plus;
                                tint: Theme.text-on-accent;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                            }

                            TouchArea {
                                clicked => {
                                    if (new-subtask.text != "") {
                                        Actions.add-subtask(root.task.id, new-subtask.text);
                                        new-subtask.text = "";
                                    }
                                }
                            }
                            accessible-role: button;
                            accessible-label: @tr("TaskDetail" => "Add a subtask");
                            accessible-action-default => {
                                if (new-subtask.text != "") {
                                    Actions.add-subtask(root.task.id, new-subtask.text);
                                    new-subtask.text = "";
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
