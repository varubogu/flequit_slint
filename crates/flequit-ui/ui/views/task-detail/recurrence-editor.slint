import { CheckBox, ScrollView, SpinBox } from "std-widgets.slint";
import { Theme } from "../../globals/theme.slint";
import { Layout } from "../../globals/layout.slint";
import { AppState } from "../../globals/app-state.slint";
import { Actions } from "../../globals/actions.slint";
import { I18n } from "../../globals/i18n.slint";
import { SettingsState } from "../../globals/settings.slint";
import { RecurrenceEnd, RecurrenceMonthlyMode, RecurrenceState, RecurrenceUnit,
         RecurrenceWeekOfMonth } from "../../globals/types.slint";
import { CalendarPopup } from "../../components/calendar-popup.slint";
import { DialogButton } from "../../components/dialog-button.slint";
import { FocusSentinel } from "../../components/focus-sentinel.slint";

// One choice in a row of mutually exclusive options.
//
// `action-label` is what assistive technology reads: the visible label is often
// an abbreviation, and "Mon" alone does not say what pressing it does.
component OptionButton inherits Rectangle {
    in property <string> label;
    in property <string> action-label: root.label;
    in property <bool> selected: false;
    callback clicked();

    height: Layout.touch-target;
    horizontal-stretch: 1;
    border-radius: Theme.radius-sm;
    border-width: 1px;
    border-color: root.selected ? Theme.accent : Theme.border;
    background: root.selected ? Theme.surface-selected
        : touch.has-hover ? Theme.surface-hover : Theme.surface;

    Text {
        width: 100%;
        height: 100%;
        text: root.label;
        color: Theme.text;
        font-size: Theme.font-size-sm;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
    accessible-role: button;
    accessible-label: root.action-label;
    accessible-action-default => { root.clicked(); }
}

// Modal editor for a task's repeat schedule.
//
// Created when it opens, so its working copy starts from `AppState.recurrence`
// and is thrown away on close. Every edit reports the whole draft back through
// `Actions.preview-recurrence`, because turning a rule into dates is domain
// logic and belongs in the ViewModel; only Save writes anything.
export component RecurrenceEditor inherits Rectangle {
    // Working copy, initialised from the state Rust published before opening.
    property <bool> enabled: AppState.recurrence.enabled;
    property <RecurrenceUnit> unit: AppState.recurrence.unit;
    property <int> interval: AppState.recurrence.interval;
    property <bool> sunday: AppState.recurrence.sunday;
    property <bool> monday: AppState.recurrence.monday;
    property <bool> tuesday: AppState.recurrence.tuesday;
    property <bool> wednesday: AppState.recurrence.wednesday;
    property <bool> thursday: AppState.recurrence.thursday;
    property <bool> friday: AppState.recurrence.friday;
    property <bool> saturday: AppState.recurrence.saturday;
    property <RecurrenceMonthlyMode> monthly-mode: AppState.recurrence.monthly-mode;
    property <int> day-of-month: AppState.recurrence.day-of-month;
    property <RecurrenceWeekOfMonth> week-of-month: AppState.recurrence.week-of-month;
    property <int> weekday-of-month: AppState.recurrence.weekday-of-month;
    property <RecurrenceEnd> end-kind: AppState.recurrence.end-kind;
    property <int> end-year: AppState.recurrence.end-year;
    property <int> end-month: AppState.recurrence.end-month;
    property <int> end-day: AppState.recurrence.end-day;
    property <int> max-occurrences: AppState.recurrence.max-occurrences;
    property <int> preview-count: AppState.recurrence.preview-count;
    // Rewinds the calendar to the stored month every time it opens.
    property <int> end-open-count: 0;

    // The task already repeats, so the editor can offer to stop it.
    property <bool> had-rule: AppState.recurrence.enabled;

    private property <bool> weekly: root.unit == RecurrenceUnit.week;
    // Every period of a month or longer picks its day the same way.
    private property <bool> monthly: root.unit == RecurrenceUnit.month
        || root.unit == RecurrenceUnit.quarter
        || root.unit == RecurrenceUnit.half-year
        || root.unit == RecurrenceUnit.year;
    private property <bool> by-weekday-of-month:
        root.monthly-mode == RecurrenceMonthlyMode.weekday-of-month;

    pure function draft() -> RecurrenceState {
        return {
            task-id: AppState.recurrence.task-id,
            enabled: root.enabled,
            unit: root.unit,
            interval: root.interval,
            sunday: root.sunday,
            monday: root.monday,
            tuesday: root.tuesday,
            wednesday: root.wednesday,
            thursday: root.thursday,
            friday: root.friday,
            saturday: root.saturday,
            monthly-mode: root.monthly-mode,
            day-of-month: root.day-of-month,
            week-of-month: root.week-of-month,
            weekday-of-month: root.weekday-of-month,
            end-kind: root.end-kind,
            end-year: root.end-year,
            end-month: root.end-month,
            end-day: root.end-day,
            max-occurrences: root.max-occurrences,
            preview-count: root.preview-count,
        };
    }

    function changed() {
        Actions.preview-recurrence(root.draft());
    }

    function select-unit(value: RecurrenceUnit) {
        root.unit = value;
        root.changed();
    }

    function select-week-of-month(value: RecurrenceWeekOfMonth) {
        root.week-of-month = value;
        root.changed();
    }

    function select-end-kind(value: RecurrenceEnd) {
        root.end-kind = value;
        root.changed();
    }

    function select-monthly-mode(value: RecurrenceMonthlyMode) {
        root.monthly-mode = value;
        root.changed();
    }

    pure function weekday-selected(index: int) -> bool {
        return index == 0 ? root.sunday
            : index == 1 ? root.monday
            : index == 2 ? root.tuesday
            : index == 3 ? root.wednesday
            : index == 4 ? root.thursday
            : index == 5 ? root.friday
            : root.saturday;
    }

    function toggle-weekday(index: int) {
        if (index == 0) {
            root.sunday = !root.sunday;
        } else if (index == 1) {
            root.monday = !root.monday;
        } else if (index == 2) {
            root.tuesday = !root.tuesday;
        } else if (index == 3) {
            root.wednesday = !root.wednesday;
        } else if (index == 4) {
            root.thursday = !root.thursday;
        } else if (index == 5) {
            root.friday = !root.friday;
        } else {
            root.saturday = !root.saturday;
        }
        root.changed();
    }

    function close() {
        AppState.recurrence-open = false;
    }

    width: 100%;
    height: 100%;
    background: #00000080;

    // Swallow clicks outside the dialog rather than closing it: the dialog
    // holds unsaved edits.
    TouchArea { }

    Rectangle {
        width: min(parent.width - 2 * Theme.space-lg, 30 * Theme.space-xl);
        height: min(parent.height - 2 * Theme.space-lg, 40 * Theme.space-xl);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: Theme.surface-raised;
        border-radius: Theme.radius-md;
        border-width: 1px;
        border-color: Theme.border;

        // Keeps Tab inside the dialog; see FocusSentinel.
        head := FocusSentinel {
            wrapped => { tail.focus(); }
        }

        VerticalLayout {
            padding: Theme.space-lg;
            spacing: Theme.space-md;

            Text {
                text: @tr("Recurrence" => "Repeat");
                color: Theme.text;
                font-size: Theme.font-size-lg;
            }

            ScrollView {
                vertical-stretch: 1;

                VerticalLayout {
                    spacing: Theme.space-md;
                    alignment: start;

                    CheckBox {
                        text: @tr("Recurrence" => "Repeat this task");
                        checked: root.enabled;
                        // First control of the dialog: everything below depends
                        // on it, so keyboard users start here.
                        init => { self.focus(); }
                        toggled => {
                            root.enabled = self.checked;
                            root.changed();
                        }
                    }

                    // --- Saved presets ---
                    // Applying one fills in the unit and the interval only; the
                    // weekday and end conditions stay as the task had them.
                    if root.enabled && SettingsState.recurrence-presets.length > 0: VerticalLayout {
                        vertical-stretch: 0;
                        spacing: Theme.space-sm;
                        Text {
                            text: @tr("Recurrence" => "Presets");
                            color: Theme.text-muted;
                            font-size: Theme.font-size-sm;
                        }
                        HorizontalLayout {
                            spacing: Theme.space-xs;
                            for preset in SettingsState.recurrence-presets: OptionButton {
                                label: I18n.recurrence-summary(preset.unit, preset.interval);
                                selected: root.unit == preset.unit
                                    && root.interval == preset.interval;
                                clicked => {
                                    root.interval = preset.interval;
                                    root.select-unit(preset.unit);
                                }
                            }
                        }
                    }

                    if root.enabled: VerticalLayout {
                        // Keep every section at its intrinsic height. Otherwise the
                        // viewport redistributes spare height when an end-condition
                        // control appears, which makes the sections above it jump.
                        vertical-stretch: 0;
                        spacing: Theme.space-md;

                        // --- How often ---
                        VerticalLayout {
                            vertical-stretch: 0;
                            spacing: Theme.space-sm;
                            Text {
                                text: @tr("Recurrence" => "How often");
                                color: Theme.text-muted;
                                font-size: Theme.font-size-sm;
                            }

                            HorizontalLayout {
                                spacing: Theme.space-sm;
                                SpinBox {
                                    value: root.interval;
                                    minimum: 1;
                                    maximum: 999;
                                    accessible-label: @tr("Recurrence" => "Repeat interval");
                                    edited(value) => {
                                        root.interval = value;
                                        root.changed();
                                    }
                                }
                                Text {
                                    text: I18n.recurrence-summary(root.unit, root.interval);
                                    color: Theme.text;
                                    font-size: Theme.font-size-base;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                }
                            }

                            HorizontalLayout {
                                spacing: Theme.space-xs;
                                OptionButton {
                                    label: I18n.recurrence-unit-label(RecurrenceUnit.minute);
                                    selected: root.unit == RecurrenceUnit.minute;
                                    clicked => { root.select-unit(RecurrenceUnit.minute); }
                                }
                                OptionButton {
                                    label: I18n.recurrence-unit-label(RecurrenceUnit.hour);
                                    selected: root.unit == RecurrenceUnit.hour;
                                    clicked => { root.select-unit(RecurrenceUnit.hour); }
                                }
                                OptionButton {
                                    label: I18n.recurrence-unit-label(RecurrenceUnit.day);
                                    selected: root.unit == RecurrenceUnit.day;
                                    clicked => { root.select-unit(RecurrenceUnit.day); }
                                }
                                OptionButton {
                                    label: I18n.recurrence-unit-label(RecurrenceUnit.week);
                                    selected: root.unit == RecurrenceUnit.week;
                                    clicked => { root.select-unit(RecurrenceUnit.week); }
                                }
                            }

                            HorizontalLayout {
                                spacing: Theme.space-xs;
                                OptionButton {
                                    label: I18n.recurrence-unit-label(RecurrenceUnit.month);
                                    selected: root.unit == RecurrenceUnit.month;
                                    clicked => { root.select-unit(RecurrenceUnit.month); }
                                }
                                OptionButton {
                                    label: I18n.recurrence-unit-label(RecurrenceUnit.quarter);
                                    selected: root.unit == RecurrenceUnit.quarter;
                                    clicked => { root.select-unit(RecurrenceUnit.quarter); }
                                }
                                OptionButton {
                                    label: I18n.recurrence-unit-label(RecurrenceUnit.half-year);
                                    selected: root.unit == RecurrenceUnit.half-year;
                                    clicked => { root.select-unit(RecurrenceUnit.half-year); }
                                }
                                OptionButton {
                                    label: I18n.recurrence-unit-label(RecurrenceUnit.year);
                                    selected: root.unit == RecurrenceUnit.year;
                                    clicked => { root.select-unit(RecurrenceUnit.year); }
                                }
                            }
                        }

                        // --- Weekly: which weekdays ---
                        if root.weekly: VerticalLayout {
                            vertical-stretch: 0;
                            spacing: Theme.space-sm;
                            Text {
                                text: @tr("Recurrence" => "On these days");
                                color: Theme.text-muted;
                                font-size: Theme.font-size-sm;
                            }
                            HorizontalLayout {
                                spacing: Theme.space-xs;
                                for index in [0, 1, 2, 3, 4, 5, 6]: OptionButton {
                                    label: I18n.weekday-abbreviation(index);
                                    action-label: I18n.weekday-label(index);
                                    selected: root.weekday-selected(index);
                                    clicked => { root.toggle-weekday(index); }
                                }
                            }
                        }

                        // --- Monthly and longer: which day of the period ---
                        if root.monthly: VerticalLayout {
                            vertical-stretch: 0;
                            spacing: Theme.space-sm;
                            Text {
                                text: @tr("Recurrence" => "Which day");
                                color: Theme.text-muted;
                                font-size: Theme.font-size-sm;
                            }

                            OptionButton {
                                label: @tr("Recurrence" => "Same day as the due date");
                                selected: root.monthly-mode == RecurrenceMonthlyMode.same-day;
                                clicked => {
                                    root.select-monthly-mode(RecurrenceMonthlyMode.same-day);
                                }
                            }

                            HorizontalLayout {
                                spacing: Theme.space-sm;
                                OptionButton {
                                    label: @tr("Recurrence" => "Day of the month");
                                    selected: root.monthly-mode == RecurrenceMonthlyMode.day-of-month;
                                    clicked => {
                                        root.select-monthly-mode(RecurrenceMonthlyMode.day-of-month);
                                    }
                                }
                                SpinBox {
                                    value: root.day-of-month;
                                    minimum: 1;
                                    maximum: 31;
                                    enabled: root.monthly-mode == RecurrenceMonthlyMode.day-of-month;
                                    accessible-label: @tr("Recurrence" => "Which day of the month");
                                    edited(value) => {
                                        root.day-of-month = value;
                                        root.changed();
                                    }
                                }
                            }

                            OptionButton {
                                label: @tr("Recurrence" => "A weekday of a given week");
                                selected: root.by-weekday-of-month;
                                clicked => {
                                    root.select-monthly-mode(RecurrenceMonthlyMode.weekday-of-month);
                                }
                            }

                            if root.by-weekday-of-month: HorizontalLayout {
                                spacing: Theme.space-xs;
                                OptionButton {
                                    label: I18n.week-of-month-label(RecurrenceWeekOfMonth.first);
                                    selected: root.week-of-month == RecurrenceWeekOfMonth.first;
                                    clicked => {
                                        root.select-week-of-month(RecurrenceWeekOfMonth.first);
                                    }
                                }
                                OptionButton {
                                    label: I18n.week-of-month-label(RecurrenceWeekOfMonth.second);
                                    selected: root.week-of-month == RecurrenceWeekOfMonth.second;
                                    clicked => {
                                        root.select-week-of-month(RecurrenceWeekOfMonth.second);
                                    }
                                }
                                OptionButton {
                                    label: I18n.week-of-month-label(RecurrenceWeekOfMonth.third);
                                    selected: root.week-of-month == RecurrenceWeekOfMonth.third;
                                    clicked => {
                                        root.select-week-of-month(RecurrenceWeekOfMonth.third);
                                    }
                                }
                                OptionButton {
                                    label: I18n.week-of-month-label(RecurrenceWeekOfMonth.fourth);
                                    selected: root.week-of-month == RecurrenceWeekOfMonth.fourth;
                                    clicked => {
                                        root.select-week-of-month(RecurrenceWeekOfMonth.fourth);
                                    }
                                }
                                OptionButton {
                                    label: I18n.week-of-month-label(RecurrenceWeekOfMonth.last);
                                    selected: root.week-of-month == RecurrenceWeekOfMonth.last;
                                    clicked => {
                                        root.select-week-of-month(RecurrenceWeekOfMonth.last);
                                    }
                                }
                            }

                            if root.by-weekday-of-month: HorizontalLayout {
                                spacing: Theme.space-xs;
                                for index in [0, 1, 2, 3, 4, 5, 6]: OptionButton {
                                    label: I18n.weekday-abbreviation(index);
                                    action-label: I18n.weekday-label(index);
                                    selected: root.weekday-of-month == index;
                                    clicked => {
                                        root.weekday-of-month = index;
                                        root.changed();
                                    }
                                }
                            }
                        }

                        // --- Termination ---
                        VerticalLayout {
                            vertical-stretch: 0;
                            spacing: Theme.space-sm;
                            Text {
                                text: @tr("Recurrence" => "Ends");
                                color: Theme.text-muted;
                                font-size: Theme.font-size-sm;
                            }

                            HorizontalLayout {
                                spacing: Theme.space-xs;
                                OptionButton {
                                    label: @tr("Recurrence" => "Never");
                                    selected: root.end-kind == RecurrenceEnd.never;
                                    clicked => { root.select-end-kind(RecurrenceEnd.never); }
                                }
                                OptionButton {
                                    label: @tr("Recurrence" => "On a date");
                                    selected: root.end-kind == RecurrenceEnd.on-date;
                                    clicked => { root.select-end-kind(RecurrenceEnd.on-date); }
                                }
                                OptionButton {
                                    label: @tr("Recurrence" => "After a number of times");
                                    selected: root.end-kind == RecurrenceEnd.after-count;
                                    clicked => { root.select-end-kind(RecurrenceEnd.after-count); }
                                }
                            }

                            if root.end-kind == RecurrenceEnd.on-date: Rectangle {
                                height: Layout.touch-target;
                                background: end-touch.has-hover ? Theme.surface-hover : Theme.surface;
                                border-radius: Theme.radius-sm;
                                border-width: 1px;
                                border-color: Theme.border;

                                Text {
                                    x: Theme.space-sm;
                                    width: parent.width - 2 * Theme.space-sm;
                                    height: 100%;
                                    text: Actions.preview-datetime(
                                        SettingsState.current-datetime-format,
                                        root.end-year, root.end-month, root.end-day, 23, 59);
                                    color: Theme.text;
                                    font-size: Theme.font-size-base;
                                    vertical-alignment: center;
                                }

                                end-touch := TouchArea {
                                    clicked => {
                                        end-popup.show();
                                        root.end-open-count += 1;
                                    }
                                }
                                accessible-role: button;
                                accessible-label: @tr("Recurrence" => "Choose the last date");
                                accessible-action-default => { end-touch.clicked(); }
                            }

                            if root.end-kind == RecurrenceEnd.after-count: SpinBox {
                                value: root.max-occurrences;
                                minimum: 1;
                                maximum: 999;
                                accessible-label: @tr("Recurrence" => "Number of times");
                                edited(value) => {
                                    root.max-occurrences = value;
                                    root.changed();
                                }
                            }
                        }

                        // --- Preview ---
                        VerticalLayout {
                            vertical-stretch: 0;
                            spacing: Theme.space-xs;
                            Text {
                                text: @tr("Recurrence" => "Next dates");
                                color: Theme.text-muted;
                                font-size: Theme.font-size-sm;
                            }

                            if root.end-kind == RecurrenceEnd.never: HorizontalLayout {
                                vertical-stretch: 0;
                                spacing: Theme.space-sm;
                                Text {
                                    text: @tr("Recurrence" => "Preview count");
                                    color: Theme.text;
                                    font-size: Theme.font-size-base;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                                SpinBox {
                                    value: root.preview-count;
                                    minimum: 1;
                                    maximum: 999;
                                    accessible-label: @tr("Recurrence" => "Preview count");
                                    edited(value) => {
                                        root.preview-count = value;
                                        root.changed();
                                    }
                                }
                            }

                            if AppState.recurrence-preview.length == 0: Text {
                                text: @tr("Recurrence" => "This schedule has no upcoming dates.");
                                color: Theme.text-muted;
                                font-size: Theme.font-size-base;
                                wrap: word-wrap;
                            }

                            for occurrence in AppState.recurrence-preview: Text {
                                text: occurrence;
                                color: Theme.text;
                                font-size: Theme.font-size-base;
                            }
                        }
                    }
                }
            }

            HorizontalLayout {
                spacing: Theme.space-sm;
                alignment: end;

                if root.had-rule: DialogButton {
                    label: @tr("Recurrence" => "Stop repeating");
                    destructive: true;
                    clicked => {
                        Actions.clear-recurrence(AppState.recurrence.task-id);
                        root.close();
                    }
                }

                DialogButton {
                    label: @tr("Recurrence" => "Cancel");
                    clicked => { root.close(); }
                }

                DialogButton {
                    label: @tr("Recurrence" => "Save");
                    primary: true;
                    clicked => {
                        Actions.save-recurrence(root.draft());
                        root.close();
                    }
                }
            }
        }

        tail := FocusSentinel {
            wrapped => { head.focus(); }
        }
    }

    end-popup := CalendarPopup {
        title: @tr("Recurrence" => "Select the last date");
        open-token: root.end-open-count;
        with-time: false;
        year: root.end-year;
        month: root.end-month;
        day: root.end-day;

        accepted(year, month, day, hour, minute) => {
            root.end-year = year;
            root.end-month = month;
            root.end-day = day;
            root.changed();
        }
    }
}
