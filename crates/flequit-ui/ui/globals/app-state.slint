import { TaskItem, SubTaskItem, ProjectItem, DueFilterItem, Pane, TaskSort, ColorOption,
         EditorState, TagItem, BookmarkedTagItem, RecurrenceState,
         SearchSuggestion, StatusFilterItem, AddTargetItem } from "types.slint";

// Application state shared across views.
//
// Written by Rust (ViewModels), read by views. Views may write only the
// transient fields marked below; anything that must be persisted or that
// triggers a domain operation goes through Actions instead.

export global AppState {
    // --- Data, pushed by ViewModels ---
    in-out property <[ProjectItem]> projects;
    in-out property <[TaskItem]> tasks;
    in-out property <[DueFilterItem]> due-filters;
    in-out property <[StatusFilterItem]> status-filters: [
        { key: "open" },
        { key: "completed" },
    ];
    // The palette the project editor offers. Published once at startup.
    in-out property <[ColorOption]> project-colors;
    in-out property <[TagItem]> tags;
    in-out property <[BookmarkedTagItem]> bookmarked-tags;
    // Whether archived projects are listed. Owned by the ViewModel because the
    // project model is rebuilt when it changes.
    in-out property <bool> show-archived-projects: false;

    // --- Selection ---
    // The project the tag manager and "new list" work on. Derived by the
    // ViewModel from the search query, the selected task or the add target:
    // the sidebar itself holds no selection.
    in-out property <string> selected-project-id;
    in-out property <string> selected-task-id;
    in-out property <string> selected-subtask-id;

    // Resolved by the ViewModel rather than looked up in the view: Slint
    // bindings are declarative expressions, and searching a model is logic.
    in-out property <TaskItem> selected-task;
    in-out property <bool> has-selected-task: false;
    // The subtask the detail pane shows instead of its parent, resolved the
    // same way. `selected-task` stays filled in so the pane can go back to it.
    in-out property <SubTaskItem> selected-subtask;
    in-out property <bool> has-selected-subtask: false;

    // --- Navigation (compact layout only) ---
    in-out property <Pane> active-pane: Pane.list;
    // Transient: views may toggle this directly.
    in-out property <bool> sidebar-open: false;

    in-out property <bool> sidebar-collapsed: false;

    // --- Keyboard focus coordination ---
    // Conditional panes cannot be referenced by id from the window. The shell
    // increments one of these counters and the visible view focuses itself.
    in-out property <int> focus-search-request: 0;
    in-out property <int> focus-list-request: 0;
    in-out property <int> focus-detail-request: 0;
    in-out property <int> focus-new-task-request: 0;

    // --- Search ---
    // What the search box shows. Rust keeps the confirmed `@` tokens.
    in-out property <string> search-query;
    // Candidates for the `@` / `#` word being typed.
    in-out property <[SearchSuggestion]> search-suggestions;
    // Candidates for a name that fits several targets; non-empty while the
    // disambiguation list is open.
    in-out property <[SearchSuggestion]> search-candidates;
    // `@` words that name nothing, and words still naming several targets,
    // joined by spaces for the warning line. Empty when there are none.
    in-out property <string> search-unresolved;
    in-out property <string> search-ambiguous;
    // A stray `)` or `|` was skipped.
    in-out property <bool> search-syntax-issue: false;
    // Incremented when the disambiguation list should open.
    in-out property <int> search-candidates-request: 0;
    // Incremented when Rust rewrites the query, so the caret moves to the end.
    in-out property <int> search-caret-request: 0;

    // --- Quick add ---
    // Where the quick-add field puts a new task.
    in-out property <string> add-target-list-id;
    in-out property <string> add-target-project-name;
    in-out property <string> add-target-list-name;
    in-out property <brush> add-target-color;
    in-out property <bool> add-target-has-color: false;
    // The lists the destination picker offers, narrowed by its filter.
    in-out property <[AddTargetItem]> add-targets;

    // --- Ordering ---
    // Applied by the ViewModel when it rebuilds `tasks`.
    in-out property <TaskSort> task-sort: TaskSort.manual;

    // --- Drag and drop ---
    // Transient: views write these directly while a row is being dragged, and
    // the drop is reported through Actions when the pointer is released.
    in-out property <string> dragging-task-id;
    // The dragged task's project, so only lists that can receive it light up.
    in-out property <string> dragging-project-id;
    // Pointer position in window coordinates. A drop target anywhere in the
    // window can compare it against its own `absolute-position`.
    in-out property <length> drag-x;
    in-out property <length> drag-y;
    // The task list under the pointer, empty when there is none.
    in-out property <string> drop-list-id;
    out property <bool> is-dragging: root.dragging-task-id != "";

    // --- Sidebar editor ---
    // Transient: the sidebar opens the editor by filling these in.
    in-out property <bool> editor-open: false;
    in-out property <EditorState> editor;
    in-out property <bool> tag-manager-open: false;

    // --- Recurrence editor ---
    // Transient: the detail pane opens the editor through Actions, which fills
    // in the working copy and the preview before showing it.
    in-out property <bool> recurrence-open: false;
    in-out property <RecurrenceState> recurrence;
    // The next few dates the current draft would fire on, already formatted in
    // the user's timezone. Empty when the draft repeats nothing.
    in-out property <[string]> recurrence-preview;

    // --- Async status ---
    in-out property <bool> loading: false;
    // Empty string means "no error". Holds display-ready text resolved via I18n.
    in-out property <string> error-message;

    // --- Scroll coordination ---
    // Set by ViewModels to bring a row into view; -1 means "no request".
    in-out property <int> scroll-to-index: -1;

    // --- Derived helpers ---
    out property <bool> has-error: root.error-message != "";
    out property <bool> has-selection: root.selected-task-id != "" || root.selected-subtask-id != "";
}
