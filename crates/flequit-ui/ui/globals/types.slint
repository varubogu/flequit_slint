// UI-facing data types.
//
// These are display-ready: dates are pre-formatted strings, optionals are
// resolved into a value plus a `has-*` flag. Domain types never reach the UI.
// Conversion lives in crates/flequit-ui/src/adapters/.

export enum TaskStatus { not-started, in-progress, waiting, completed, cancelled }

export enum TaskPriority { none, low, medium, high }

export enum Pane { list, detail }

// How the task list is ordered. `manual` is the stored order, which is what
// drag and drop rearranges; the others are derived and cannot be dragged.
export enum TaskSort { manual, due, priority, title }

export enum SettingsCategory { basic, date-time, appearance, account, data-sync }

// The period a recurrence rule steps by. Mirrors the domain enum, including the
// units the editor does not offer, so a rule written by another client survives
// a round trip through this UI.
export enum RecurrenceUnit { minute, hour, day, week, month, quarter, half-year, year }

// How a monthly (or longer) rule picks its day inside the period.
export enum RecurrenceMonthlyMode { same-day, day-of-month, weekday-of-month }

export enum RecurrenceWeekOfMonth { first, second, third, fourth, last }

// What stops a recurrence rule.
export enum RecurrenceEnd { never, on-date, after-count }

// The recurrence editor's working copy of a task's rule.
//
// Transient view state: Rust fills it in when the editor opens and the dialog
// edits its own copy from there. Saving goes through Actions.
//
// The weekday flags are seven fields rather than an array because .slint has no
// way to write back into one element of a model.
export struct RecurrenceState {
    task-id: string,
    // False when the task does not repeat; the editor still shows defaults.
    enabled: bool,
    unit: RecurrenceUnit,
    interval: int,
    // Weekly rules: the weekdays the rule fires on.
    sunday: bool,
    monday: bool,
    tuesday: bool,
    wednesday: bool,
    thursday: bool,
    friday: bool,
    saturday: bool,
    // Monthly and longer rules: how the day inside the period is chosen.
    monthly-mode: RecurrenceMonthlyMode,
    day-of-month: int,
    week-of-month: RecurrenceWeekOfMonth,
    // 0 is Sunday, matching `weekday-label`.
    weekday-of-month: int,
    end-kind: RecurrenceEnd,
    // Local calendar fields, like the due-date picker uses.
    end-year: int,
    end-month: int,
    end-day: int,
    max-occurrences: int,
    // Used only when the rule has no end; finite rules preview every remaining date.
    preview-count: int,
}

export struct DateTimeFormatSetting {
    id: string,
    name: string,
    format: string,
    kind: string,
}

export struct DueButtonSetting {
    key: string,
    visible: bool,
}

// The horizon a user-defined due filter covers. Longer periods are already
// covered by the built-in week / month / quarter / year buttons.
export enum DueUnit { minute, hour, day }

// A due filter the user added, e.g. 10 minutes or 5 days.
export struct CustomDueFilterSetting {
    value: int,
    unit: DueUnit,
}

// A recurrence pattern the user saved for reuse in the repeat editor.
export struct RecurrencePresetSetting {
    interval: int,
    unit: RecurrenceUnit,
}

// The unit used by configurable relative reminder choices.
export enum ReminderUnit { minute, hour, day }

export struct ReminderPresetSetting {
    value: int,
    unit: ReminderUnit,
    minutes-before: int,
}

export struct ReminderItem {
    // UTC RFC 3339 timestamp used as the stable removal key.
    key: string,
    label: string,
}

// What a hand-typed date resolved to.
//
// `valid` is false when the text does not describe a real date, which is the
// normal state while the user is still typing. `has-time` says whether the text
// carried a time of day at all, so a date-only entry keeps the time the picker
// already held.
export struct ParsedDateTime {
    valid: bool,
    year: int,
    month: int,
    day: int,
    hour: int,
    minute: int,
    has-time: bool,
}

// How strongly the search query uses a sidebar item. Derived from the query:
// the sidebar holds no selection of its own.
export enum FilterHighlight {
    none,
    // One of the top-level OR terms.
    weak,
    // One of the top-level AND terms, or the whole query.
    strong,
    // Negated at the top level.
    excluded,
}

// What a sidebar item does to the search query.
export enum QueryEdit {
    // Plain click: show only this item, or clear when it is all there is.
    click,
    // Command / Ctrl + click: AND it in, or take it back out.
    toggle-and,
    // Option / Alt + click: OR it in, or take it back out.
    toggle-or,
    // Context menu entries.
    replace,
    and,
    or,
    exclude,
    remove,
}

// The kind of sidebar item a query edit comes from.
export enum FilterKind { due, status, project, task-list, tag }

// A direct child of a task, as the detail pane lists it.
//
// A subtask is a task with a parent; selecting it opens it as a TaskItem.
// This summary only carries what the list in the parent's pane shows.
export struct SubTaskItem {
    id: string,
    title: string,
    completed: bool,
    // Pre-formatted in the user's timezone and format preference, like TaskItem.
    due-label: string,
    has-due: bool,
    overdue: bool,
    // Its own direct children, so the row can show that it leads further down.
    subtask-count: int,
}

// A task above the one shown in the detail pane, top-level first.
export struct AncestorItem {
    id: string,
    title: string,
}

// One task at any depth: a row of the task list and the detail pane's subject.
//
// The list is a flat sequence of rows in display order; a subtask's row follows
// its parent's and carries a larger `depth`. Slint structs cannot nest
// themselves, so the hierarchy is expressed by `depth` and `parent-id`.
export struct TaskItem {
    id: string,
    project-id: string,
    // The list its top-level task belongs to; empty when directly under the
    // project.
    list-id: string,
    // Empty for a top-level task.
    parent-id: string,
    // 0 for a top-level task, 1 for its subtasks, and so on.
    depth: int,
    title: string,
    status: TaskStatus,
    priority: TaskPriority,
    completed: bool,
    // Pre-formatted in the user's timezone and format preference.
    due-label: string,
    has-due: bool,
    overdue: bool,
    // Local display values consumed by DateTimePicker.
    due-year: int,
    due-month: int,
    due-day: int,
    due-hour: int,
    due-minute: int,
    // A range task spans start → due; otherwise only the due date is used.
    is-range-date: bool,
    start-label: string,
    has-start: bool,
    start-year: int,
    start-month: int,
    start-day: int,
    start-hour: int,
    start-minute: int,
    notes: string,
    tag-labels: [string],
    // Direct children only; deeper levels are reached by opening a child.
    subtasks: [SubTaskItem],
    subtask-count: int,
    subtask-done-count: int,
    // The tasks above this one, top-level first. Empty for a top-level task.
    ancestors: [AncestorItem],
    // Recurrence, summarised by `I18n.recurrence-summary`. The unit and the
    // interval are passed separately because the sentence is built in .slint.
    has-recurrence: bool,
    recurrence-unit: RecurrenceUnit,
    recurrence-interval: int,
    reminders: [ReminderItem],
    // Accordion state, owned by TaskListUiViewModel and mirrored here. Also
    // true while the search shows the row only for its matching subtasks.
    expanded: bool,
    // The task itself does not match the search; only tasks below it do.
    search-dimmed: bool,
    // How many tasks below it match, while it is dimmed.
    matched-subtask-count: int,
    // It matches the search while the task above it does not.
    search-match: bool,
}

// Which kind of item the sidebar editor is working on.
export enum EditorKind { project, task-list }

// A colour a project can be tagged with.
//
// `value` is what the domain stores and what the editor sends back; `swatch` is
// the same colour already parsed, because .slint cannot turn text into a colour.
export struct ColorOption {
    value: string,
    swatch: brush,
}

// What the sidebar editor is editing.
//
// Transient view state: it is filled in when the editor opens and discarded
// when it closes. Saving goes through Actions like every other mutation.
export struct EditorState {
    kind: EditorKind,
    // Empty when creating a new item.
    target-id: string,
    // The project being edited, or the one a new list belongs to.
    project-id: string,
    name: string,
    // Hex colour, empty when unset. Projects only.
    color: string,
    archived: bool,
}

export struct TaskListItem {
    id: string,
    project-id: string,
    name: string,
    task-count: int,
    highlight: FilterHighlight,
}

export struct ProjectItem {
    id: string,
    name: string,
    // Fallback shown when collapsed and no icon is set: first 2-3 characters.
    short-label: string,
    // Hex colour as stored, empty when unset. Sent back by the editor.
    color: string,
    // The same colour parsed for rendering; transparent when unset.
    color-brush: brush,
    has-color: bool,
    is-archived: bool,
    task-lists: [TaskListItem],
    expanded: bool,
    highlight: FilterHighlight,
}

export struct TagItem {
    id: string,
    project-id: string,
    name: string,
    color: string,
    color-brush: brush,
    has-color: bool,
    bookmarked: bool,
    assigned: bool,
}

export struct BookmarkedTagItem {
    id: string,
    project-id: string,
    name: string,
    color-brush: brush,
    has-color: bool,
    highlight: FilterHighlight,
}

export struct DueFilterItem {
    // Stable key, e.g. "today". Sent back to Rust on click.
    key: string,
    label: string,
    // Search text this button writes into the search box, e.g. "@today".
    query: string,
    count: int,
    visible: bool,
    // Zero for built-in filters; positive for user-defined filters, where
    // `custom-unit` says what the value counts.
    custom-value: int,
    custom-unit: DueUnit,
    highlight: FilterHighlight,
}

// A sidebar button filtering by task state. `key` is "open" or "completed".
export struct StatusFilterItem {
    key: string,
    count: int,
    highlight: FilterHighlight,
}

// A project the quick-add field can put a task in: the first crumb of the
// destination.
export struct AddTargetProjectItem {
    id: string,
    name: string,
    color-brush: brush,
    has-color: bool,
}

// A place inside the destination's project: one of its task lists, or the
// project itself for a task that belongs to no list. The second crumb.
export struct AddTargetItem {
    // The list id, or `project:{id}` for the project itself.
    key: string,
    // Empty for the project itself.
    list-name: string,
}

export enum SearchSuggestionKind { due, status, project, task-list, user, tag }

// A candidate for the word being typed, or for a name that fits several
// targets. Picked by position; Rust keeps what each one stands for.
export struct SearchSuggestion {
    // The token as it would appear in the search box, e.g. "@仕事.今週やる".
    label: string,
    kind: SearchSuggestionKind,
    // Due and state keys ("today", "open"), a list's project, a user's handle.
    detail: string,
    color-brush: brush,
    has-color: bool,
    // A project's number of lists.
    count: int,
    archived: bool,
}

export struct LocaleItem {
    tag: string,
    display-name: string,
}

// A change that was never applied to Automerge (a `failed` sync queue row),
// listed under Settings > Data sync so it can be inspected and requeued.
export struct FailedSyncChangeItem {
    // Queue row id, passed back to `Actions.requeue-failed-sync-change`.
    id: string,
    // What was changed, e.g. `task.save`. Shown as-is: it is diagnostic data.
    kind: string,
    // Which Automerge document it belongs to, e.g. `project:{uuid}`.
    document: string,
    attempts: int,
    // Last error reported while applying it; empty when none was recorded.
    error: string,
    // When the change was made, formatted in the display timezone.
    created-at: string,
}
