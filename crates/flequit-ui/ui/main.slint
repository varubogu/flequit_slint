import { Palette } from "std-widgets.slint";
import { Theme, ThemeMode } from "globals/theme.slint";
import { Layout, Breakpoint } from "globals/layout.slint";
import { AppState } from "globals/app-state.slint";
import { Actions } from "globals/actions.slint";
import { Capabilities } from "globals/capabilities.slint";
import { I18n } from "globals/i18n.slint";
import { SettingsState } from "globals/settings.slint";
import { TaskItem, ProjectItem, TaskListItem, SubTaskItem, DueFilterItem, LocaleItem,
         ColorOption, DateTimeFormatSetting, DueButtonSetting, ReminderItem, EditorState, SettingsCategory, TaskStatus,
         TaskPriority, TaskSort, EditorKind, Pane, TagItem, BookmarkedTagItem, RecurrenceState,
         RecurrenceUnit, RecurrenceMonthlyMode, RecurrenceWeekOfMonth, RecurrenceEnd,
         SearchSuggestion, SearchSuggestionKind } from "globals/types.slint";
import { Sidebar } from "views/sidebar/sidebar.slint";
import { ItemEditor } from "views/sidebar/item-editor.slint";
import { TagManager } from "views/tags/tag-manager.slint";
import { TaskListView } from "views/task-list/task-list.slint";
import { TaskDetailView } from "views/task-detail/task-detail.slint";
import { SubTaskDetailView } from "views/task-detail/subtask-detail.slint";
import { RecurrenceEditor } from "views/task-detail/recurrence-editor.slint";
import { ErrorBanner } from "components/error-banner.slint";
import { IconButton } from "components/icon-button.slint";
import { IconName } from "components/icon.slint";
import { SettingsDialog } from "views/settings/settings-dialog.slint";

// Re-export globals so Rust can reach them through the generated bindings.
export { Theme, Layout, AppState, Actions, Capabilities, I18n, SettingsState }
export { TaskItem, ProjectItem, TaskListItem, SubTaskItem, DueFilterItem, LocaleItem,
         ColorOption, DateTimeFormatSetting, DueButtonSetting, ReminderItem, EditorState, SettingsCategory, TaskStatus,
         TaskPriority, TaskSort, EditorKind, Pane, TagItem, BookmarkedTagItem, ThemeMode, Breakpoint,
         SearchSuggestion, SearchSuggestionKind }
export { RecurrenceState, RecurrenceUnit, RecurrenceMonthlyMode, RecurrenceWeekOfMonth, RecurrenceEnd }

export component AppWindow inherits Window {
    title: "Flequit";
    background: Theme.background;
    // Applying the font choice here rather than on every Text keeps one place
    // to change and lets std-widgets pick it up too.
    default-font-family: Theme.font-family;
    default-font-size: Theme.font-size-base;
    preferred-width: 1200px;
    preferred-height: 800px;
    min-width: 320px;
    min-height: 480px;

    // Single source of truth for every responsive decision in the app.
    // Assigning here means a narrow desktop window behaves exactly like a phone.
    changed width => { Layout.window-width = self.width; }

    // Capture Slint's startup value as an immediate fallback. The platform-backed
    // ViewModel updates `Theme.system-dark` when the OS changes afterwards.
    private property <bool> dark-scheme: Theme.dark;

    init => {
        Theme.system-dark = Palette.color-scheme == ColorScheme.dark;
        Palette.color-scheme = Theme.dark ? ColorScheme.dark : ColorScheme.light;
    }

    changed dark-scheme => {
        Palette.color-scheme = self.dark-scheme ? ColorScheme.dark : ColorScheme.light;
    }

    // In compact the panes are exclusive; elsewhere both are visible.
    private property <bool> show-list:
        Layout.is-compact ? AppState.active-pane == Pane.list : true;
    private property <bool> show-detail:
        Layout.is-compact ? AppState.active-pane == Pane.detail : true;
    private property <bool> inline-sidebar-collapsed:
        Layout.is-medium || AppState.sidebar-collapsed;

    HorizontalLayout {
        spacing: 0px;

        // --- Inline sidebar: expanded and medium only ---
        if !Layout.is-compact: Rectangle {
            width: root.inline-sidebar-collapsed
                ? Layout.sidebar-collapsed-width
                : Layout.sidebar-width;
            Sidebar {
                width: 100%;
                height: 100%;
                collapsed: root.inline-sidebar-collapsed;
                collapse-enabled: Layout.is-expanded;
                collapse-toggled => {
                    AppState.sidebar-collapsed = !AppState.sidebar-collapsed;
                }
            }
        }

        if !Layout.is-compact: Rectangle {
            width: 1px;
            background: Theme.border;
        }

        // --- Content ---
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 0px;

            // Compact-only top bar with the hamburger.
            if Layout.is-compact: Rectangle {
                height: Layout.touch-target + 2 * Theme.space-sm + Layout.safe-area-top;
                background: Theme.surface;

                HorizontalLayout {
                    padding: Theme.space-sm;
                    padding-top: Theme.space-sm + Layout.safe-area-top;
                    spacing: Theme.space-sm;

                    IconButton {
                        icon: IconName.menu;
                        tooltip: @tr("Shell" => "Open menu");
                        clicked => { AppState.sidebar-open = true; }
                    }

                    Text {
                        text: "Flequit";
                        color: Theme.text;
                        font-size: Theme.font-size-lg;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                }
            }

            if AppState.has-error: Rectangle {
                height: banner.height + 2 * Theme.space-sm;
                HorizontalLayout {
                    padding: Theme.space-sm;
                    banner := ErrorBanner {
                        message: AppState.error-message;
                        dismissed => { Actions.dismiss-error(); }
                        retried => { Actions.retry-last-action(); }
                    }
                }
            }

            HorizontalLayout {
                vertical-stretch: 1;
                spacing: 0px;

                if root.show-list: TaskListView {
                    horizontal-stretch: Layout.is-expanded ? 1 : 2;
                }

                if root.show-list && root.show-detail: Rectangle {
                    width: 1px;
                    background: Theme.border;
                }

                // A selected subtask takes over the detail pane; its own back
                // button returns to the parent task rather than to the list.
                if root.show-detail && AppState.has-selected-subtask: SubTaskDetailView {
                    horizontal-stretch: 1;
                    subtask: AppState.selected-subtask;
                    parent-title: AppState.selected-task.title;
                }

                if root.show-detail && !AppState.has-selected-subtask: TaskDetailView {
                    horizontal-stretch: 1;
                    show-back: Layout.is-compact;
                    has-task: AppState.has-selected-task;
                    task: AppState.selected-task;
                    back => { AppState.active-pane = Pane.list; }
                }
            }
        }
    }

    // --- Compact sidebar overlay ---
    if Layout.is-compact && AppState.sidebar-open: Rectangle {
        width: 100%;
        height: 100%;
        background: #00000080;

        TouchArea {
            clicked => { AppState.sidebar-open = false; }
        }

        Rectangle {
            x: 0;
            width: Layout.sidebar-overlay-width;
            height: 100%;

            Sidebar {
                width: 100%;
                height: 100%;
                collapsed: false;
                collapse-toggled => { AppState.sidebar-open = false; }
            }
        }
    }

    // --- Project and list editor ---
    // Above the sidebar overlay: it can be opened from there.
    if AppState.editor-open: ItemEditor { }

    if AppState.tag-manager-open: TagManager { }

    // --- Repeat schedule editor ---
    if AppState.recurrence-open: RecurrenceEditor { }

    // --- Settings modal ---
    if SettingsState.open: SettingsDialog { }

    // --- Loading veil ---
    if AppState.loading: Rectangle {
        width: 100%;
        height: 100%;
        background: Theme.background.with-alpha(0.6);

        // Swallow input while loading.
        TouchArea { }

        Text {
            text: @tr("Shell" => "Loading…");
            color: Theme.text;
            font-size: Theme.font-size-lg;
            horizontal-alignment: center;
            vertical-alignment: center;
            width: 100%;
            height: 100%;
        }
    }
}
